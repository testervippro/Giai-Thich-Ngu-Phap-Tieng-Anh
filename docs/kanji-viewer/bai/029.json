,1,0,"ghep"],["放す","はなす","to let go, to release","PHÓNG",1,0,""],["事務","じむ","clerical work","SỰ VỤ",1,0,""],["所","ところ","place, spot, point","SỞ",1,0,""],["選曲","","tuyển (tuyển chọn) + khúc (Khúc nhạc)","TUYỂN KHÚC",1,0,"ghep"],["振り返る","ふりかえる","to look back","CHẤN PHẢN",1,0,""],["呼ぶ","よぶ","to call, to call out (to)","HÔ",1,0,""],["情熱","じょうねつ","enthusiasm, passion","TÌNH NHIỆT",1,0,""],["分かる","わかる","to understand, to realise, to find out","PHÂN",1,0,""],["導く","みちびく","to lead, to guide","ĐẠO",1,0,""],["何回聴","","hà (Cái gì) + hồi (Quay lại) + thính (thính giác)","HÀ HỒI THÍNH",1,1,"ghep"],["大好","","đại (To lớn) + hảo (Thích)","ĐẠI HẢO",1,0,"ghep"],["精神","せいしん","spirit, mind","TINH THẦN",1,0,""],["堅牢","","kiên (kiên cố)","KIÊN ?",1,1,"ghep"],["野郎","","dã (Hoang dã) + lang (Con trai)","DÃ LANG",1,1,"ghep"],["鋼","はがね","steel ♢","CƯƠNG",1,1,""],["錬金術","れんきんじゅつ","alchemy","LUYỆN KIM THUẬT",1,1,""],["先日","せんじつ","the other day","TIÊN NHẬT",1,0,""],["梶田","","điền (Ruộng)","? ĐIỀN",1,1,"ghep"],["中村悠一","","trung (Ở giữa) + thôn (Làng) + du (thong thả; xa xăm) + nhất (Số 1)","TRUNG THÔN DU NHẤT",1,1,"ghep"],["出演","しゅつえん","する：to appear (in a movie, play, etc.)","XUẤT DIỄN",1,0,""],["東山奈央","","đông (Phía Đông) + sơn (Núi) + nại (tận cùng) + ương (Trung ương)","ĐÔNG SƠN NẠI ƯƠNG",1,1,"ghep"],["思い出す","おもいだす","to remember, to recall","TƯ XUẤT",1,0,""],["優しい","やさしい","gentle, tender, sweet, kind-hearted","ƯU",1,0,""],["旋律","せんりつ","melody","TOÀN LUẬT",1,1,""],["大変聴","","đại (To lớn) + biến (biến đổi) + thính (thính giác)","ĐẠI BIẾN THÍNH",1,1,"ghep"],["離れる","はなれる","to be separated [apart]","LI",1,0,""],["力","ちから","power, force, (physical) strength","LỰC",1,0,""],["強固な","きょうこな","firm, solid, strong","CƯỜNG CỐ",1,1,""],["大丈夫","だいじょうぶ","all right, okay, safe","ĐẠI TRƯỢNG PHU",1,0,""],["清い","きよい","pure, clean","THANH",1,1,""],["変わる","かわる","to change, to be altered, to vary, to be amended, to be revised (vi.)","BIẾN",1,0,""],["籠もる","こもる","to shut oneself up, to be full of, to blur","LUNG",1,1,""],["割る","わる","to divide, to split, to break","CÁT",1,0,""],["上位","","thượng (Bên trên) + vị (vị trí; thứ hạng)","THƯỢNG VỊ",1,1,"ghep"],["間違い","まちがい","a mistake, error, accident, mishap","GIAN VI",1,0,""],["年前","","niên (Năm) + tiền (Trước)","NIÊN TIỀN",1,0,"ghep"],["信じる","しんじる","to believe (in), to trust","TÍN",1,0,""],["古臭","","cổ (Cũ) + xú (Hôi thối)","CỔ XÚ",1,1,"ghep"],["旬","しゅん","height of the season ♢","TUẦN",1,1,""],["感覚","かんかく","sense, sensation, feeling","CẢM GIÁC",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",18,"こっちはこっちで青春のsecret baseしているものです。",[23,26]],["N5","〜が (nhưng)","nhưng",5,"爽やかで格好良い曲だが、最後のここは割と泣きポイント。",[9,12]],["N5","〜たい","muốn làm …",1,"そして「秋風の Shadow」の歌詞は丁度今くらいの時期にマッチするからやはり今聴きたいのである。",[41,45]],["N5","〜てから","sau khi … rồi mới",1,"集合場所で合流してからお別れするまでの過程が目に浮かぶようなストレートな歌詞内容が好き。",[8,11]],["N5","〜方 (cách làm)","cách làm …",1,"最後の歌詞「いつか生まれ変わる世界がその目に届くと良いな」は印象的だし、ここの歌い方にもたっぷりの想いが籠もっていてなんか泣けるんだよな。",[40,43]],["N4","〜ので","vì … (lý do khách quan)",11,"こっちはこっちで青春のsecret baseしているものです。",[27,29]],["N4","〜ようだ / 〜みたい","hình như / giống như …",8,"青春時代に夏祭りデートしたあの日を忘れないみたいな内容にはキュンです。",[21,24]],["N4","〜という","gọi là … / rằng …",7,"という文句の多いオタク心理による感想でした。",[0,3]],["N4","〜でしょう / 〜だろう","chắc là …",5,"子供ってなんで「お～」「う～」とかクソうるせぇ叫びを共に泣くのだろう。",[31,34]],["N4","〜すぎる","quá …",5,"「情けない男でごめんよ」の正直過ぎる語りから入る歌詞は印象的。",[15,18]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",5,"こういった気持ち良い生き様だとか人生教訓を得られる歌詞のセンスもナイス。",[22,25]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",2,"卒業しちゃったけど、みっくんの歌声はめっちゃ好きだったな～。",[3,6]],["N4","〜てくる","… dần lên / … rồi đến",2,"なぜ今聴きたくなったのか謎だが、こちらはリリース時からもお気入りで、よく読めない周期を置いてふとした瞬間に頭に流れてくるものなんですよ。",[57,60]],["N4","〜ば (điều kiện)","nếu …",2,"ハガレン好きの彼女が作品愛を語るのを聞けば、こちらの名曲のことも思い出した。",[19,22]],["N4","〜と (điều kiện)","hễ … thì",2,"GLAYでいうと、4曲全てがA面曲だったシングルタイトルを「G4」にしたみたいなものか。",[6,9]],["N4","〜かもしれない","có lẽ …",2,"男らしく胸のエンジンに火をつけることによって、性別についてあれこれうるさい勢から炎上騒動を起こされるということもあるのかもしれない。",[59,63]],["N4","〜てもいい","… cũng được",1,"何回聴いても良いもので大好きです。",[4,8]],["N4","〜なら","nếu là … thì",1,"ならば大丈夫だと勇気を貰える歌です。",[0,3]],["N4","〜はずだ","chắc chắn là … (theo lý)",1,"この曲はガキの頃に見たCDTVの懐かしソングカウントダウンの企画で知ったものだったはず。",[41,43]],["N4","〜やすい","dễ …",1,"ラルクビギナーには大変聴きやすいマイルドロックだと思う。",[13,16]],["N4","〜ながら","vừa … vừa …",1,"発言には気をつけながら魂への着火を完了させよう。",[8,11]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",1,"最後の歌詞「いつか生まれ変わる世界がその目に届くと良いな」は印象的だし、ここの歌い方にもたっぷりの想いが籠もっていてなんか泣けるんだよな。",[33,36]],["N4","使役 〜させる","bắt / cho phép làm …",1,"彼女達がこの曲を出してヒットさせたこと、それが偶然ではなく運命だったと今ならはっきり分かる。",[14,17]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"ZONEの夏を感じるヒット曲なら「secret base〜君がくれたもの〜」の方が先行して思い浮かぶところだろうが、こっちの夏ソングも負けず劣らず良い。",[50,54]],["N3","〜として","với tư cách là …",6,"こちらは「INTER」と銘打ったトリプルA面シングルの1曲として世に出た。",[29,32]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",3,"それも運命の力によって強固なものとなっている。",[7,11]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",3,"」ってくらい名が挙がる往年の名曲です。",[3,6]],["N3","〜に対して","đối với … / trái với …",2,"でも言わない自身に対しては自己愛も多めにあります。",[8,11]],["N3","〜ずに","không … mà",2,"だとしても「叫ばずにはいられない」この想いこそ「besten dank」。",[8,10]],["N3","〜にする (chọn)","chọn / quyết định là …",2,"このちょいダサ感を隠すことなくオープンにした感じがかえって格好良いのです。",[19,22]],["N3","〜について","về …",1,"男らしく胸のエンジンに火をつけることによって、性別についてあれこれうるさい勢から炎上騒動を起こされるということもあるのかもしれない。",[25,29]],["N3","〜ことになる","được quyết định là / hoá ra là …",1,"となれば毎週この魂が滾る伝説の名曲を聞くことになる。",[20,24]],["N3","〜ても / 〜でも (dù)","dù … cũng",1,"名曲だからいつかは出すと決めていたとしても、活動キャリアとメンバーの年齢がこれだけ若い時期に本作を放った事務所サイドの選曲は尖っている。",[19,22]],["N3","〜終わる","… xong",1,"これも毎年夏の終わり時になると無性に聞きたくなるやつ。",[7,10]],["N3","〜てほしい","muốn (ai) làm …",1,"「やさしいあつかいじゃ 物足りないよあの娘にしてるみたいにきつく抱いて欲しい」なんて熱っぽくもちょっとアダルティックな乙女願望が詰まった歌詞を、",[34,37]],["N3","〜べき","nên / phải …",1,"歌い出しの熱い歌詞で好きなのだが、昨今の世だと男だから女だからという性別を頭に持って来て「こうあるべき」と説くのはちょっと危ないのかもしれない。",[49,51]],["N3","〜ところが","thế nhưng",1,"これといって情けないところがなく、あったとしても謙って己でそれをオープンにすることもないであろう私のような人間からは出てこないワードだな。",[10,14]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",3,"良きものは独占しても皆でシェアしても結局楽しいものだからね。",[23,26]],["N2","〜からこそ","chính vì …",1,"楽しかったからこそ、祭りのあとにはちょっとの寂しさがある。",[5,9]],["N2","〜ずにはいられない","không thể không …",1,"だとしても「叫ばずにはいられない」この想いこそ「besten dank」。",[8,14]],["N2","〜がち","hay … / thường có xu hướng",1,"ちょい見せだけでもありがたいことだが、見れない部分がちょい残っているならそれはそれで余計に焦れるものがあってストレス。",[25,27]]]}
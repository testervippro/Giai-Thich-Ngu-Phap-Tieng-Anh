,1,1,"ghep"],["形","かたち","shape, form, figure","HÌNH",1,0,""],["筆","ふで","writing brush","BÚT",1,0,""],["黒","くろ","black","HẮC",1,0,""],["墨","すみ","Indian [Chinese] ink, ink stick, the black ink (stick) used in traditional Japanese calligraphy, etc.","MẶC",1,1,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",9,"タッチしている部分の画面が透明のディスクから見えるタイプで便利。",[4,7]],["N5","〜たい","muốn làm …",2,"引き続き黒側のインクがなくなるくらいいろいろ描いてみて、いずれはパロディに拠らず自分のアイデアを形にしてみたいです。",[52,57]],["N5","〜てから","sau khi … rồi mới",2,"ナガノ先生も、まず手描きしてからデジタルで描き込んでいるとのこと。",[13,16]],["N5","〜が (nhưng)","nhưng",1,"昔から絵は苦手ですが、今回ナガノ先生の使っているペンの使いやすさとワクワク感のもと作中でもひときわ単純な絵をパロディしたことで描く楽しさの一端がわかりました。",[7,11]],["N4","〜ので","vì … (lý do khách quan)",5,"以前から写真のぼかし加工やSwitchでのトモコレ用にと購入していたものです。",[35,37]],["N4","〜予定","dự định …",1,"例えば個人的な趣味の範囲を超えた意見の表明をしようと決断したときであったり、他の人と組んで何かしらの活動をしたいとなった際にはアイコンを変更する予定です。",[72,76]],["N4","〜てみる","thử làm …",1,"引き続き黒側のインクがなくなるくらいいろいろ描いてみて、いずれはパロディに拠らず自分のアイデアを形にしてみたいです。",[24,27]],["N4","〜ようだ / 〜みたい","hình như / giống như …",1,"引き続き黒側のインクがなくなるくらいいろいろ描いてみて、いずれはパロディに拠らず自分のアイデアを形にしてみたいです。",[52,55]],["N3","〜ことで","bằng việc … / do …",1,"昔から絵は苦手ですが、今回ナガノ先生の使っているペンの使いやすさとワクワク感のもと作中でもひときわ単純な絵をパロディしたことで描く楽しさの一端がわかりました。",[60,63]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",1,"引き続き黒側のインクがなくなるくらいいろいろ描いてみて、いずれはパロディに拠らず自分のアイデアを形にしてみたいです。",[15,18]],["N2","〜をはじめ","tiêu biểu là / trước hết là …",1,"本家と見比べるとやはり線の不安定な太さをはじめ至らなさが目についたものの、なんだかんだ気に入ったので複数SNSアカウントのアイコンに設定しました。",[19,23]],["N2","〜をもとに","dựa trên …",1,"とはいえちいかわ作中の画風を元にしている絵だとオリジナルのアイコン以上にSNSでの発言にプレッシャーが",[13,16]],["N2","〜ものの","tuy … nhưng",1,"本家と見比べるとやはり線の不安定な太さをはじめ至らなさが目についたものの、なんだかんだ気に入ったので複数SNSアカウントのアイコンに設定しました。",[33,36]]]}
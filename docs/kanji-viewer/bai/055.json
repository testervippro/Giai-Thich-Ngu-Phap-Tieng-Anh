,1,"ghep"],["新作","","tân (mới) + tác (Tác giả)","TÂN TÁC",1,0,"ghep"],["団長","","đoàn (đoàn thể) + trường, trưởng (dài)","ĐOÀN TRƯỜNG, TRƯỞNG",1,1,"ghep"],["紹介","しょうかい","する：to introduce, to present","THIỆU GIỚI",1,0,""],["全部","ぜんぶ","all, whole","TOÀN BỘ",1,0,""],["集英社文庫","","tập (Tập trung) + anh (Tiếng Anh) + xã (Xã hội) + văn (Văn học) + khố (Kho)","TẬP ANH XÃ VĂN KHỐ",1,1,"ghep"],["集英社","","tập (Tập trung) + anh (Tiếng Anh) + xã (Xã hội)","TẬP ANH XÃ",1,0,"ghep"],["巡る","めぐる","to travel around","TUẦN",1,0,""],["年前","","niên (Năm) + tiền (Trước)","NIÊN TIỀN",1,0,"ghep"],["異なる","ことなる","to be different, to vary","DỊ",1,0,""],["共通の","きょうつうの","common, mutual","CỘNG THÔNG",1,0,""],["懐かしい","なつかしい","dear old, fondly-remembered, yearn","HOÀI",1,1,""],["名前","なまえ","name","DANH TIỀN",1,0,""],["筆致","","bút (Cái bút) + trí (nhất trí)","BÚT TRÍ",1,1,"ghep"],["食傷気味","","thực (Ăn) + thương (Vết thương) + khí (Nguyên khí) + vị (Hương vị)","THỰC THƯƠNG KHÍ VỊ",1,1,"ghep"],["内側","うちがわ","inside","NỘI TRẮC",1,0,""],["掘る","ほる","to dig, to excavate","QUẬT",1,0,""],["下げる","さげる","to bring down, to lower","HẠ",1,0,""],["心地","","tâm (Trái tim) + địa (đất)","TÂM ĐỊA",1,0,"ghep"],["今回","こんかい","this time","KIM HỒI",1,0,""],["内面","","nội (Bên trong) + diện (Màn hình)","NỘI DIỆN",1,0,"ghep"],["勝手","","thắng (chiến thắng) + thủ (Cái tay)","THẮNG THỦ",1,0,"ghep"],["酔う","よう","to get drunk","TÚY",1,0,""],["取材","しゅざい","する：to collect [gather] (news materials, data, etc.)","THỦ TÀI",1,1,""],["聴く","きく","to listen, to hear","THÍNH",1,0,""],["関係","かんけい","relation, relationship","QUAN HỆ",1,0,""],["十二分","","thập (Số 10) + nhị (Số 2) + phân (Phân chia)","THẬP NHỊ PHÂN",1,1,"ghep"],["伝う","つたう","to go along","TRUYỀN",1,0,""],["見出","","kiến (Nhìn) + xuất (ra ngoài)","KIẾN XUẤT",1,0,"ghep"],["耽溺","","nịch (chết đuối)","? NỊCH",1,1,"ghep"],["悪い","わるい","bad, wrong, evil, harmful","ÁC",1,0,""],["以上","","dĩ (cái mốc) + thượng (Bên trên)","DĨ THƯỢNG",1,0,"ghep"],["最近","さいきん","recently, lately","TỐI CẬN",1,0,""],["遍路","","biến (phổ thiên) + lộ (Con đường)","BIẾN LỘ",1,1,"ghep"],["体","からだ","body","THỂ",1,0,""],["心持","","tâm (Trái tim) + trì (Duy trì)","TÂM TRÌ",1,1,"ghep"],["日","ひ","day, sun","NHẬT",1,0,""],["無理","","vô (vô lý) + lí (Lí do)","VÔ LÍ",1,0,"ghep"]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",31,"随筆をすぐそばで見ている人だからこその言葉があるな、と思う。",[9,12]],["N5","〜から (lý do)","vì … nên",4,"だから、この記事は私の自己が描かれているものになっている。",[0,4]],["N5","〜たい","muốn làm …",2,"あと、ちょっと文句を言いたいのだけれど、収録されている文章の書かれた年がわからないのはいただけない。",[11,15]],["N5","〜が (nhưng)","nhưng",2,"どちらも好きだったが、「八月の御所グラウンド」は直木賞受賞が納得の出来栄えというか、美しい物語だと思った。",[8,11]],["N5","〜てください","hãy làm … (nhờ, yêu cầu lịch sự)",1,"ぜひ読んでください。",[4,8]],["N5","〜たことがある","đã từng …",1,"紹介されている中では3/9しか私は行ったことがない、のでそのうち全部行こうと思います。",[19,25]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",17,"だから、この記事は私の自己が描かれているものになっている。",[15,18]],["N4","〜という","gọi là … / rằng …",13,"なんというかね、作りが雑だし、手抜き感も感じてしまうし。",[2,5]],["N4","〜てくる","… dần lên / … rồi đến",12,"それはわかっているし、その敬意も十二分に文章から伝わってくる。",[27,30]],["N4","〜ので","vì … (lý do khách quan)",11,"すごく平易で読みやすいし、環状島モデルはイメージがしやすいので助かった。",[29,31]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",8,"なんというかね、作りが雑だし、手抜き感も感じてしまうし。",[22,26]],["N4","〜ようだ / 〜みたい","hình như / giống như …",7,"そして今でもなお繰り返し読む、いわばバイブルのようなシリーズである。",[23,26]],["N4","〜ていく","… dần đi / … rồi đi",6,"万城目学の作品がもともと好きなのもあり、夢中でどんどん読み進めていった。",[31,34]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",6,"なんというかね、作りが雑だし、手抜き感も感じてしまうし。",[12,15]],["N4","〜でしょう / 〜だろう","chắc là …",5,"あとはやっぱり、「自己とは何か（あるいはおいしい牡蠣フライの食べ方）」でしょう。",[35,39]],["N4","〜(よ)うと思う","định / tính làm …",4,"時間的にも立場的にも距離ができた今、初めて言葉にしてもよいことがあるのだろうと思う。",[36,40]],["N4","〜てもいい","… cũng được",2,"西加奈子のエッセイが好きで（『この話、続けてもいいですか。",[21,25]],["N4","〜ば (điều kiện)","nếu …",2,"でもどちらかといえば、この本を私は勉強としてではなく、自らのトラウマの治療的な意味合いで読んでいた。",[8,11]],["N4","〜かもしれない","có lẽ …",2,"あるいは、これは受け取る私の側の問題なのかもしれないですけどね。",[20,24]],["N4","〜すぎる","quá …",2,"ただ、小川洋子の筆致が大袈裟すぎる気もして、ちょっと食傷気味だな、とも思った。",[14,17]],["N4","〜ことができる","có thể …",1,"たまに読み返すことで姿勢を整えることができそう。",[16,21]],["N4","〜ておく","làm sẵn, làm trước",1,"心の忙しさから感想を言葉にすることもなく放置してしまっていたので、今一度、どうにか言葉にしておこうと思う。",[45,48]],["N4","〜てある","(đã được ai đó) … sẵn",1,"トラウマについてある程度の知識はあっても、自分自身のこととして対処するのは難しくて、どうにもならないことが多かった。",[7,10]],["N4","〜てくれる","(ai đó) làm … cho mình",1,"書かれていること自体は真新しいものではないのだけれど、しかしそれを言語化しまとめてくれているのはありがたい。",[40,43]],["N4","〜と (điều kiện)","hễ … thì",1,"読んでいると、3年前まで働いていたものづくりの現場の空気が蘇ってくるような感じもして、なんだか懐かしくなった。",[4,7]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"鴨川ホルモーもそうだけど、ありえないような出来事も京都であるなら起きても不思議じゃないと思えてしまうのだ。",[6,10]],["N4","〜やすい","dễ …",1,"すごく平易で読みやすいし、環状島モデルはイメージがしやすいので助かった。",[8,11]],["N4","〜にくい","khó …",1,"収録順も年代別ではないので、現代の話の次に大正時代の話があったりして、すっと文章に入っていきにくい。",[46,49]],["N4","〜ながら","vừa … vừa …",1,"だから、この本を読みながら自分を相対化して（距離を取って）、それでなんとか向き合っていたな、と今振り返ってみれば思える。",[10,13]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"それぞれにいる領域は違えど、「臨床」と「ことば」に焦点を当てているというところで共通する2人だ。",[36,40]],["N4","〜しか〜ない","chỉ … (mà thôi)",1,"紹介されている中では3/9しか私は行ったことがない、のでそのうち全部行こうと思います。",[13,25]],["N3","〜について","về …",6,"精神科医である宮地尚子による、トラウマについての入門書。",[19,23]],["N3","〜として","với tư cách là …",6,"とはいえ改めて概説として読むことで再確認というか、理解を深めることはできたかなと思う。",[9,12]],["N3","〜べき","nên / phải …",5,"『恐るべき』に出会っていなかったら私は今香川にいないと思う。",[3,5]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",4,"精神科医である宮地尚子による、トラウマについての入門書。",[11,14]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",3,"で、その『恐るべき』の新作が出たというわけである。",[19,22]],["N3","〜ことで","bằng việc … / do …",3,"つまり、受け取るときに余計なエネルギーを使わない、ということです。",[28,31]],["N3","〜続ける","tiếp tục …",2,"西加奈子のエッセイが好きで（『この話、続けてもいいですか。",[19,22]],["N3","〜にとって","đối với (ai) …",1,"私は一人旅が好きだし、それでこの本も手に取ったのだと思うのだけれど、私にとって一人旅というのはもうありふれた当たり前のようなものであって、つまりそこ",[35,39]],["N3","〜ことになる","được quyết định là / hoá ra là …",1,"きっとこの先、現場に出て臨床の空気を吸って生きていく中で、もう一度読み返すことになるのだろうな、と思う。",[37,41]],["N3","〜ても / 〜でも (dù)","dù … cũng",1,"トラウマについてある程度の知識はあっても、自分自身のこととして対処するのは難しくて、どうにもならないことが多かった。",[18,21]],["N3","〜終わる","… xong",1,"じとか、敵わないやと天を見上げる感じとか、そういうものがあまりないまま終わってしまったな、と思う。",[35,38]],["N3","〜わけではない","không hẳn là …",1,"もう20年以上前の対談でもあるから、すべてが現代に適用できるわけではないのだろうけれど、臨床でやっていく上でのエッセンスが詰まっている対談だった。",[30,36]],["N3","〜せいで","tại / do (lỗi)",1,"最近はお遍路で体を動かしているせいか、あまり読むような心持ちにならない日の方が多いのだけれど、無理せずに心の動くままにこれからも読んでいこうと思います。",[15,18]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",1,"それくらいの傑作である。",[2,5]],["N3","〜ずに","không … mà",1,"最近はお遍路で体を動かしているせいか、あまり読むような心持ちにならない日の方が多いのだけれど、無理せずに心の動くままにこれからも読んでいこうと思います。",[50,52]],["N3","〜ないと","phải … (không thì)",1,"あまり共感的になれないというか……。",[9,13]],["N3","〜ところが","thế nhưng",1,"この手のアンソロジーはおしなべてそういったところがある。",[21,25]],["N2","〜上で","khi / trong việc … / sau khi …",2,"もちろん、この本はきちんと取材をし、直接現場を見て、直接話を聴き、工場や関係者に敬意をはらった上で書かれている。",[47,49]],["N2","〜からこそ","chính vì …",1,"随筆をすぐそばで見ている人だからこその言葉があるな、と思う。",[14,18]],["N2","〜気味","hơi có vẻ …",1,"ただ、小川洋子の筆致が大袈裟すぎる気もして、ちょっと食傷気味だな、とも思った。",[28,30]],["N2","〜ことはない","không cần phải …",1,"ちょっと（だいぶ）うんざりしてきたので、もうこういうアンソロジーに手を出すことはないかな。",[37,42]]]}
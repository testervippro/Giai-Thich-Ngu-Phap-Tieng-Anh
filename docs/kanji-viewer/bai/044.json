,["行程","","hành (Đi) + trình (Lộ trình)","HÀNH TRÌNH",1,0,"ghep"],["体","からだ","body","THỂ",1,0,""],["覚えている","おぼえている","to remember, to have [keep, bear] something in mind","GIÁC",1,0,""],["自身","じしん","(one's) self","TỰ THÂN",1,0,""],["取る","とる","to take, to get, to hold, to remove","THỦ",1,0,""],["囲む","かこむ","to surround, to enclose","VI",1,0,""],["環境","かんきょう","environment","HOÀN CẢNH",1,0,""],["認識","にんしき","する：to recognise, to understand, to perceive","NHẬN THỨC",1,0,""],["静けさ","しずけさ","stillness, silence, calm, peace","TĨNH",1,1,""],["朝","あさ","morning","TRIỀU",1,0,""],["過ごす","すごす","to spend (a day, a holiday [vacation], etc.)","QUÁ",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",12,"そうすれば移動手段と併せ宿泊方法も解決するなあと考えていた。",[26,29]],["N5","〜が (nhưng)","nhưng",5,"キャンプギア購入の初期費用はまずまずかかったが、車を購入orレンタルするよりははるかに安価に済んだ。",[21,24]],["N5","〜たい","muốn làm …",1,"なんとありがたい。",[5,9]],["N5","〜から (lý do)","vì … nên",1,"我が家の車は購入してもう15年だから、別途車中泊できるような軽自動車のワンボックスのバンでも買って、旅が終わったら今の車を売って入れ替えようか。",[15,19]],["N5","〜たことがある","đã từng …",1,"これまで水辺にテントを張ったことがなかったので湖畔サイトがいいなと行ってみたが、とても人気のキャンプ場で波打ち際はもういっぱい。",[13,19]],["N5","〜前に","trước khi …",1,"目の前に林立していたテントは全て無くなり、支笏湖の眺めを遮るものは消え去ってしまったのだった。",[1,4]],["N4","〜てくる","… dần lên / … rồi đến",7,"しかし、ありがたいことに連れが車を持って行ってもいいよと言ってくれた。",[30,33]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",5,"・翌朝、テントから顔を出すと辺りは霧に覆われていた。",[20,23]],["N4","〜てくれる","(ai đó) làm … cho mình",3,"しかし、ありがたいことに連れが車を持って行ってもいいよと言ってくれた。",[30,33]],["N4","〜ので","vì … (lý do khách quan)",3,"こうしてとうとうキャンプを始めるきっかけを掴んだのであった。",[24,26]],["N4","〜ようだ / 〜みたい","hình như / giống như …",3,"いいなあ、やってみたいなあ、と思うばかりで実際にやるきっかけを掴めずにいた。",[8,11]],["N4","〜てみる","thử làm …",2,"いいなあ、やってみたいなあ、と思うばかりで実際にやるきっかけを掴めずにいた。",[7,10]],["N4","使役 〜させる","bắt / cho phép làm …",2,"ビールをやりながら心行くまで暮れなずむ湖面に目を遊ばせた。",[25,28]],["N4","〜という","gọi là … / rằng …",2,"いや、正確には焚火したい熱というのが正しいか。",[13,16]],["N4","〜ばかり","toàn là … / vừa mới …",2,"いいなあ、やってみたいなあ、と思うばかりで実際にやるきっかけを掴めずにいた。",[17,20]],["N4","〜しか〜ない","chỉ … (mà thôi)",2,"おー、湖上は真っ白で手前の砂浜しか見えない。",[15,21]],["N4","〜てもいい","… cũng được",1,"しかし、ありがたいことに連れが車を持って行ってもいいよと言ってくれた。",[22,26]],["N4","〜ことができる","có thể …",1,"そうした前日の行程から体が覚えている自身を取り囲む環境の認識も相まって、静けさをより纏った朝を過ごすことができた。",[50,55]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",1,"目の前に林立していたテントは全て無くなり、支笏湖の眺めを遮るものは消え去ってしまったのだった。",[37,41]],["N4","〜ていく","… dần đi / … rồi đi",1,"夕方になると次々にテントを畳んで帰っていった。",[18,21]],["N4","〜ようになる","trở nên (có thể) …",1,"以降、Googleマップでの検索結果から選択するようになる。",[24,29]],["N4","〜と (điều kiện)","hễ … thì",1,"くのお店を検索していたのだが、ふと思いつきキャンプ場を同じように検索すると、なっぷに登録されていないキャンプ場もたくさんあることに気づいた。",[35,38]],["N4","〜ながら","vừa … vừa …",1,"ビールをやりながら心行くまで暮れなずむ湖面に目を遊ばせた。",[6,9]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"区画サイトしかないところだと2000円前後するが、フリーサイトがあれば1000円前後で泊まれる（",[9,13]],["N3","〜ところが","thế nhưng",2,"・ところがその日は日曜日でほとんどがデイキャンプだったよう。",[1,5]],["N3","〜ことになる","được quyết định là / hoá ra là …",1,"・キャンプするには当然その日の晩と翌朝の食糧を持ち込む必要があり、スーパーかコンビニで事前に購入することになる。",[50,54]],["N3","〜はじめる / 〜始める","bắt đầu …",1,"こうしてとうとうキャンプを始めるきっかけを掴んだのであった。",[13,16]],["N3","〜続ける","tiếp tục …",1,"キャンプ用品なんて一つも持っていなかったが、例の番組を見続けていたから必要なものが何かはほぼ見当がつく。",[28,31]],["N3","〜終わる","… xong",1,"我が家の車は購入してもう15年だから、別途車中泊できるような軽自動車のワンボックスのバンでも買って、旅が終わったら今の車を売って入れ替えようか。",[52,55]],["N3","〜とおり","đúng như …",1,"立ち上る炎の揺らめきは映像で見たとおりで、ボーっといつまでも見ていられる癒しがあった。",[16,19]],["N3","〜ずに","không … mà",1,"いいなあ、やってみたいなあ、と思うばかりで実際にやるきっかけを掴めずにいた。",[33,35]],["N2","〜をはじめ","tiêu biểu là / trước hết là …",1,"こうしてとうとうキャンプを始めるきっかけを掴んだのであった。",[12,15]],["N2","〜ことはない","không cần phải …",1,"これまでバンガローとかに泊まったことはあるが、テントで眠ったことはない。",[30,35]]]}
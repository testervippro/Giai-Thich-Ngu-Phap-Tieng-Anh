NG",1,0,"ghep"],["与える","あたえる","to give, to provide","DỰ",1,0,""],["合否","","hợp (Hòa hợp) + phủ (phủ định)","HỢP PHỦ",1,1,"ghep"],["手法","","thủ (Cái tay) + pháp (phương pháp)","THỦ PHÁP",1,0,"ghep"],["判定手法","","phán (Phán đoán) + định (cố định) + thủ (Cái tay) + pháp (phương pháp)","PHÁN ĐỊNH THỦ PHÁP",1,1,"ghep"],["画面","","họa, hoạch (Họa sĩ) + diện (Màn hình)","HỌA, HOẠCH DIỆN",1,0,"ghep"],["拾う","ひろう","to pick up, to gather","THẬP",1,0,""],["準備","じゅんび","する：to prepare for","CHUẨN BỊ",1,0,""],["一目で","ひとめで","at a glance, at first sight","NHẤT MỤC",1,1,""],["機能","","cơ (cơ khí, máy móc) + năng (năng lực)","CƠ NĂNG",1,0,"ghep"],["目的","もくてき","purpose, aim, goal","MỤC ĐÍCH",1,0,""],["一","いち","one","NHẤT",1,0,""],["手間","てま","time, labour, effort","THỦ GIAN",1,0,""],["回帰","","hồi (Quay lại) + quy (trở về)","HỒI QUY",1,1,"ghep"],["有効な","ゆうこうな","effective, valid","HỮU HIỆU",1,0,""],["詳細な","しょうさいな","detailed","TƯỜNG TẾ",1,0,""],["割愛","","cát (vỡ) + ái (Yêu)","CÁT ÁI",1,0,"ghep"],["且つ","かつ","moreover, besides, and","THẢ",1,1,""],["低廉","","đê (thấp) + liêm (liêm khiết)","ĐÊ LIÊM",1,1,"ghep"],["作成中","","tác (Tác giả) + thành (thành công) + trung (Ở giữa)","TÁC THÀNH TRUNG",1,1,"ghep"],["弊社","へいしゃ","our company (humble)","TỆ XÃ",1,1,""],["一緒に","いっしょに","together, with","NHẤT TỰ",1,0,""],["推進","すいしん","する：to promote, to propel, to push forward","SUY TIẾN",1,0,""],["仲間","","trọng (Trọng tài) + gian (Thời gian)","TRỌNG GIAN",1,0,"ghep"],["募集","ぼしゅう","recruitment, solicitation","MỘ TẬP",1,0,""]],"grammar":[["N5","〜が (nhưng)","nhưng",6,"※今回は例としてXPathを掲載していますが、cssセレクタ等でも可。",[19,23]],["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",4,"主なものは先に記載しているとおり、クリックと文字列の入力です。",[10,13]],["N5","〜方 (cách làm)","cách làm …",4,"今回はJavaを利用した書き方を紹介します。",[13,16]],["N4","〜てくる","… dần lên / … rồi đến",6,"何らかのプログラミング言語を触ったことさえあれば誰でもできます。",[27,30]],["N4","〜ことができる","có thể …",4,"実際の制御については、以下の構文にて行うことができます。",[20,25]],["N4","〜ので","vì … (lý do khách quan)",3,"に当てはめて、自動化した処理を並べていくだけなので、非常に簡単です。",[23,2
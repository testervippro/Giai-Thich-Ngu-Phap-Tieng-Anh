p"],["自社","","tự (Tự tin) + xã (Xã hội)","TỰ XÃ",1,0,"ghep"],["軌跡","","quỹ (quỹ đạo) + tích (dấu tích)","QUỸ TÍCH",1,1,"ghep"],["成長","せいちょう","する：to grow, to mature","THÀNH TRƯỜNG",1,0,""],["転換点","","chuyển (Chuyển động) + hoán (hoán đổi) + điểm (Điểm số)","CHUYỂN HOÁN ĐIỂM",1,1,"ghep"],["東映","","đông (Phía Đông) + ánh (Phản ánh)","ĐÔNG ÁNH",1,1,"ghep"],["中期","","trung (Ở giữa) + kì (kì hạn)","TRUNG KÌ",1,1,"ghep"],["計画","けいかく","する：to plan","KẾ HỌA",1,0,""],["統合","とうごう","する：to unite, to combine","THỐNG HỢP",1,0,""],["各社","","các (Các vị) + xã (Xã hội)","CÁC XÃ",1,1,"ghep"],["転載","","chuyển (Chuyển động) + tải (đăng tải)","CHUYỂN TẢI",1,1,"ghep"],["朝","あさ","morning","TRIỀU",1,0,""],["正義","せいぎ","justice","CHÍNH NGHĨA",1,0,""],["情熱","じょうねつ","enthusiasm, passion","TÌNH NHIỆT",1,0,""],["再会","さいかい","する：to meet again","TÁI HỘI",1,0,""],["称賛","しょうさん","する：to praise, to admire","XƯNG TÁN",1,0,""],["補う","おぎなう","to make up for, to supplement, to complement","BỔ",1,1,""],["任天堂","","nhiệm (trách nhiệm) + thiên (Trời) + đường (võ đường)","NHIỆM THIÊN ĐƯỜNG",1,1,"ghep"],["目","め","eye","MỤC",1,0,""],["変わる","かわる","to change, to be altered, to vary, to be amended, to be revised (vi.)","BIẾN",1,0,""],["変える","かえる","to change, to alter, to reform (a system), to amend (a regulation) (vt.)","BIẾN",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",53,"しかし、作品の魅力は人物描写だけで成立しているわけではない。",[20,23]],["N5","〜が (nhưng)","nhưng",4,"だが、そう仮定したとして、鑑賞者側がその理論を採用する根拠はどこにあるのだろうか。",[0,3]],["N5","〜たり〜たりする","lúc thì … lúc thì … (liệt kê hành động)",4,"例えば、何も成し遂げない人物が周囲から愛されていたり、物語の中で肯定的に扱われていたりする場合である。",[24,45]],["N5","〜方 (cách làm)","cách làm …",3,"登場人物に関する四つの捉え方は、恒川によるユーリ・マーゴリンのキャラクター論の整理を参照した。",[12,15]],["N5","〜から (lý do)","vì … nên",1,"Q2. キャラクターを売りにした作品なのだから、登場人物の活躍が重視されるのは当然だ。",[20,24]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",54,"③ キャラクターの価値は、個別に足し合わせられるとは限らない",[21,24]],["N4","〜でしょう / 〜だろう","chắc là …",22,"そうした判断は、どのような根拠によって正当化されるのだろうか。",[26,29]],["N4","〜ので","vì … (lý do khách quan)",18,"そして、その不寛容さを、架空の人物にまで持ち込んでいるのではないだろうか。",[27,29]],["N4","〜ば (điều kiện)","nếu …",18,"これを登場人物への批判に応用すれば、次の可能性が考えられる。",[15,18]],["N4","〜という","gọi là … / rằng …",18,"自分が作品を適切に評価できる人物であるという認識を強める。",[19,22]],["N4","〜場合","trường hợp …",12,"架空の人物に適用する場合は、以下のような仮説になると私は考える。",[10,12]],["N4","〜ようだ / 〜みたい","hình như / giống như …",10,"そうした判断は、どのような根拠によって正当化されるのだろうか。",[10,13]],["N4","使役 〜させる","bắt / cho phép làm …",9,"ここであらかじめはっきりさせておきたいことがある。",[12,15]],["N4","〜ために","để … / vì …",7,"①自分の存在価値を守るために、他者にも生産性を要求するから",[11,14]],["N4","〜なければならない","phải …",6,"私たちは、存在意義を証明し続けなければならないのかと。",[15,22]],["N4","〜かもしれない","có lẽ …",6,"指南書によって大きく異なる）を達成するための創作技法として有用なのかもしれない。",[33,37]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",5,"ただし、自分の優位性を確認したい人が、必ず他者を罵倒するわけではない。",[1,4]],["N4","〜ように (mục đích)","để …",4,"以上に示すように、物語への寄与は、活躍や事件の解決だけではない。",[5,9]],["N4","〜と (điều kiện)","hễ … thì",4,"この知見を今回の問題に応用すると、以下のような仮説が考えられる。",[14,17]],["N4","〜なら","nếu là … thì",4,"そうであるならば、一つの作品における出演時間や見せ場だけを基準に、その人物の扱いや価値を判断することには限界があるだろう。",[5,8]],["N4","〜しか〜ない","chỉ … (mà thôi)",4,"キツネは、作品全体からみれば限られた場面にしか登場しない。",[21,28]],["N4","〜てくる","… dần lên / … rồi đến",3,"例えば、ある人が「私は努力してきたからこそ、今の立場にいる」と考えているとする。",[14,17]],["N4","〜ことができる","có thể …",2,"3つまり、物語の登場人物には非常に多様な役割を見出すことができるのだ。",[26,31]],["N4","〜ておく","làm sẵn, làm trước",2,"ここであらかじめはっきりさせておきたいことがある。",[14,17]],["N4","〜てはいけない","không được …",1,"Q1. 出番の少なさを、作品の欠点として評価してはいけないのか。",[23,27]],["N4","〜なくてもいい","không cần … cũng được",1,"理解できなくても大丈夫です。",[4,11]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",1,"「成果を出さない人物も、そのまま存在してよい」という考えを認めると、自分が従ってきた成果主義的な価値観も相対化されてしまう。",[57,61]],["N4","〜てみる","thử làm …",1,"例えば、サン＝テグジュペリの『星の王子さま』に登場するキツネを考えてみる。",[33,36]],["N4","〜てもらう","được (ai đó) làm … cho",1,"人物の魅力や特徴を認識してもらう",[12,16]],["N4","〜ようになる","trở nên (có thể) …",1,"質を備え，コミュニケーション行為にもかかわる存在として扱うことができるようになるのである",[35,40]],["N4","〜ながら","vừa … vừa …",1,"私は日々仕事をしながら、失敗を重ね、失敗を避けようと苦心している中で、社会における自らの存在意義を問わない日はない。",[8,11]],["N3","〜として","với tư cách là …",25,"Q1. 出番の少なさを、作品の欠点として評価してはいけないのか。",[17,20]],["N3","〜ても / 〜でも (dù)","dù … cũng",19,"なお、同じIPに属するコンテンツであっても、制作・事業上の目的が異なりうる",[19,22]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",15,"そうした判断は、どのような根拠によって正当化されるのだろうか。",[15,19]],["N3","〜について","về …",11,"ここで、①～④について、以下の点に着目してほしい。",[7,11]],["N3","〜ことで","bằng việc … / do …",9,"③登場人物を見下すことで、自分の優位性を確保したいから",[9,12]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",8,"しかし、作品の魅力は人物描写だけで成立しているわけではない。",[23,26]],["N3","〜わけではない","không hẳn là …",7,"しかし、作品の魅力は人物描写だけで成立しているわけではない。",[23,29]],["N3","〜ようとする","định / cố …",6,"限られた描写量の中ですべての人物に見せ場を与えようとすれば、必然的に他の描写を削る必要が生じる。",[23,27]],["N3","〜ばかりでなく / 〜だけでなく","không chỉ … mà còn",5,"個々の人物だけでなく、作品世界全体に価値を持たせる",[5,10]],["N3","〜とは限らない","không hẳn lúc nào cũng …",4,"③ キャラクターの価値は、個別に足し合わせられるとは限らない",[24,28]],["N3","〜に対して","đối với … / trái với …",3,"物語世界に既に存在している登場人物に対して、なぜ役割や貢献による存在の正当化が要求されるのかを検討する。",[17,20]],["N3","〜てほしい","muốn (ai) làm …",3,"ここで、①～④について、以下の点に着目してほしい。",[20,23]],["N3","〜ために (nguyên nhân)","vì …",3,"②自分の努力を正当化するため、「役に立たない存在」を否定したいから",[12,15]],["N3","〜べき","nên / phải …",3,"また、脚本術や創作論では、登場人物が物語において果たすべき役割について、さまざまな指針が提案されている。",[27,29]],["N3","〜に関して / 〜に関する","liên quan đến …",2,"登場人物に関する四つの捉え方は、恒川によるユーリ・マーゴリンのキャラクター論の整理を参照した。",[4,8]],["N3","〜にする (chọn)","chọn / quyết định là …",2,"Q2. キャラクターを売りにした作品なのだから、登場人物の活躍が重視されるのは当然だ。",[13,16]],["N3","〜にとって","đối với (ai) …",1,"その人にとって、努力や成果とは無関係に他者の存在価値が認められることは、自分の世界観と矛盾するように感じられるかもしれない。",[3,7]],["N3","〜ほど","đến mức … / khoảng …",1,"映画のうち約15分しか画面に現れないにもかかわらず、作品全体を支配するほどの存在感を放つと評している。",[35,37]],["N3","〜ないと","phải … (không thì)",1,"ただし、単に出番が少ないという事実から、直ちに作品の欠点が導かれるわけではない。",[10,14]],["N3","〜一方","mặt khác / ngày càng …",1,"一方で、推し以外の登場人物を「空気」「不要」などと評することで、その人物の描写を削減し、推しの活躍を増やすことの正当性を主張しようとしている可能性もある。",[0,3]],["N2","〜を通じて / 〜を通して","thông qua …",4,"アニメ化などを通じて、原作書籍や関連作品への関心・需要を高める",[6,9]],["N2","〜に基づいて","dựa trên …",2,"さらに、制作体制や商業上の制約といった作品外の事情を、確認できる資料に基づいて考慮することも有意義だろう。",[34,37]],["N2","〜からこそ","chính vì …",2,"例えば、ある人が「私は努力してきたからこそ、今の立場にいる」と考えているとする。",[17,21]],["N2","〜にもかかわらず","mặc dù …",2,"この背景には、作品に時間や感情を投じたにもかかわらず、期待したものが得られなかったことへの不満があると私は考えている。",[19,26]],["N2","〜をはじめ","tiêu biểu là / trước hết là …",1,"本作ではナビィの語りかけをはじめ、登場人物の台詞や会話も数多く追加されており、私自身、原作以上に人物の魅力が増していると感じた。",[12,16]],["N2","〜に沿って","theo …",1,"「脚本術に沿って作成されたものが傑作である」のならば採用理由があるのかもしれないが、その基準を採択する理由などあるのだろうか。",[4,6]],["N2","〜に加えて","thêm vào …",1,"商品販売に加え、ライセンス、ゲーム、映像配信、イベント等から収益を得る",[4,7]],["N2","〜をもとに","dựa trên …",1,"なお、本表は各社の公式な目的分類を転載したものではなく、事業方針等をもとに筆者が独自に分類したものである。",[33,37]],["N2","〜ものの","tuy … nhưng",1,"登場人物を非現実世界の一員であるものの，現実の人間にとてもよく似た，存在しえたかもしれない人間としてとらえる。",[16,19]],["N2","〜としたら / 〜とすれば","giả sử …",1,"限られた描写量の中ですべての人物に見せ場を与えようとすれば、必然的に他の描写を削る必要が生じる。",[25,29]],["N2","〜ことから","từ việc … (căn cứ)",1,"ただし、そのことから各人物の出演価値を最大化する義務や、すべての人物に十分な見せ場を与える義務までは導けない。",[6,10]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",1,"気だった」「出番が少なかった」といった言説は、私自身昔からよく見てきたものだが、なぜ、それが作品の欠点を指摘する言葉として通用するのだろうか。",[35,38]],["N2","〜に過ぎない","chỉ là … mà thôi",1,"なぜなら、作品やキャラクターを活用するIP事業には多様な目的があり、出演時間の配分は、それらを実現するための手段の一つにすぎないからである。",[59,64]],["N1","〜をもって","bằng / vào lúc …",1,"つまり、特定の物語上の機能が見いだせないことをもって、その人物が物語に存在する意義まで否定することはできない。",[22,26]],["N1","〜であれ","dù là …",1,"さらに、その判断が批評者自身の好みに由来するものであっても、それを作品の欠点として提示するのであれば、相応の理由づけが必要だろう。",[46,49]],["N1","〜にかかわる","liên quan đến (sống còn) …",1,"登場人物には、物語の展開に関わることのほかにも、人物造形、世界観の提示、主題の表現、美的効果など、さまざまな働きが考えられる。",[12,16]]]}
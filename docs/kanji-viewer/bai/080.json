n, to take notice of","CHÚ Ý",1,0,""],["向く","むく","to face, to turn [tend] (toward), to suit (one's preferences)","HƯỚNG",1,0,""],["庭","にわ","garden, yard, backyard","ĐÌNH",1,0,""],["黄昏","","hoàng (Màu vàng)","HOÀNG ?",1,1,"ghep"],["不安な","ふあんな","uneasy, insecure","BẤT AN",1,0,""],["吐く","はく","to vomit, to spew, to spit","THỐ",1,0,""],["避ける","さける","to avoid, to evade, to shirk","TỴ",1,0,""],["通る","とおる","to go along, to pass through [along]","THÔNG",1,0,""],["差し伸べる","さしのべる","to reach out (one's hand)","SAI THÂN",1,0,""],["警笛","けいてき","warning horn, alarm whistle","CẢNH ĐỊCH",1,1,""],["鳴る","なる","to ring, to sound, to thunder","MINH",1,0,""],["領域","りょういき","territory, domain","LÃNH VỰC",1,0,""],["運命","うんめい","fate","VẬN MỆNH",1,0,""],["肝心な","かんじんな","main, essential","GAN TÂM",1,0,""],["発生","","phát (phát triển) + sinh (Học sinh)","PHÁT SINH",1,0,"ghep"],["教える","おしえる","to teach, to tell","GIÁO",1,0,""],["有耶無耶","","hữu (Có) + vô (vô lý)","HỮU ? VÔ ?",1,1,"ghep"],["待つ","まつ","to wait","ĐÃI",1,0,""],["弱い","よわい","weak, feeble, faint","NHƯỢC",1,0,""],["招く","まねく","to invite, to bring about","CHIÊU",1,0,""],["足す","たす","to add, to supply","TÚC",1,0,""],["通","つう","connoisseur, expert","THÔNG",1,0,""],["無力感","","vô (vô lý) + lực (Sức lực) + cảm (cảm giác)","VÔ LỰC CẢM",1,1,"ghep"],["精神","せいしん","spirit, mind","TINH THẦN",1,0,""],["方","ほう","direction, way","PHƯƠNG",1,0,""],["腹が立つ","はらがたつ","to get angry","PHÚC LẬP",1,0,""],["悪意","あくい","ill will, malice","ÁC Ý",1,0,""],["返す","かえす","to return, to give something back","PHẢN",1,0,""],["悔しい","くやしい","mortifying, vexing, regrettable","HỐI",1,1,""],["反論","","phản (Phản đối) + luận (tranh luận)","PHẢN LUẬN",1,0,"ghep"],["大問題","","đại (To lớn) + vấn (Hỏi) + đề (Vấn đề)","ĐẠI VẤN ĐỀ",1,1,"ghep"],["漏らす","もらす","to reveal, to divulge, to express (one's feelings)","LẬU",1,1,""],["今度","こんど","shortly, soon, this time, next time","KIM ĐỘ",1,0,""],["動揺","どうよう","する：to waver, to be disturbed","ĐỘNG DAO",1,1,""],["振る","ふる","to wave, to shake (one's head)","CHẤN",1,0,""],["払う","はらう","to pay","PHẤT",1,0,""],["回数","","hồi (Quay lại) + số (số học)","HỒI SỐ",1,0,"ghep"],["増える","ふえる","to increase, to multiply (vi.)","TĂNG",1,0,""],["大した","たいした","great, serious, important, considerable (as in 大した問題ではない)","ĐẠI",1,0,""],["向き","むき","(wind, etc.) direction","HƯỚNG",1,0,""],["積む","つむ","to load, to pile up","TÍCH",1,0,""],["重ねる","かさねる","to pile up, to repeat","TRỌNG",1,0,""],["答える","こたえる","to answer, to reply, to respond","ĐÁP",1,0,""],["一部","いちぶ","a portion, a part of","NHẤT BỘ",1,0,""],["来週","らいしゅう","next week","LAI CHU",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",29,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[22,25]],["N5","〜前に","trước khi …",4,"ハンニンダーを目の前にして変身ができないあんなとみくる。",[8,11]],["N5","〜が (nhưng)","nhưng",3,"話中では語られなかったが、キュアアルカナだって同じように救われたんだ。",[10,13]],["N5","〜たい","muốn làm …",1,"出会って半年以上で不安なことは吐き出して楽になれと言いたいのだろうが、探偵としての経験が避けて通れないと物語っているようでもある。",[26,30]],["N5","〜方 (cách làm)","cách làm …",1,"ニジーの精神を揺さぶるやり方には腹が立つし、偽者という悪意ある言葉には驚くばかりだ。",[12,15]],["N4","〜てくる","… dần lên / … rồi đến",16,"日頃の鬱憤をこの場でぶつけてくるとは実に彼らしい。",[13,16]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",16,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[25,28]],["N4","〜でしょう / 〜だろう","chắc là …",10,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[26,29]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",5,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[17,21]],["N4","使役 〜させる","bắt / cho phép làm …",5,"でまかせでも探偵を困惑させる姿に惹かれるものがあります。",[11,14]],["N4","〜という","gọi là … / rằng …",5,"別に友達というのは相手の家庭環境を知らなければならないなんていうことは無いからね。",[4,7]],["N4","〜はずだ","chắc chắn là … (theo lý)",3,"彼女の視界にはみくるがいるはずなのに、この場面では距離感がある。",[13,15]],["N4","〜てみる","thử làm …",2,"書き終えてみて",[4,7]],["N4","〜ていく","… dần đi / … rồi đi",2,"見る回数が増えていくごとに、みくるの嘘が大したことでは無いように思えてくる。",[7,10]],["N4","〜ために","để … / vì …",2,"スターキラリングブローチの四つの光を覚醒させないために、とどめを刺す。",[24,27]],["N4","〜と (điều kiện)","hễ … thì",2,"彼が必死にミラージュの書の予言を回避しようと、変身のできない二人を揺さぶるのは無理があるんだ。",[20,23]],["N4","〜らしい","có vẻ / đúng chất …",2,"日頃の鬱憤をこの場でぶつけてくるとは実に彼らしい。",[21,24]],["N4","〜すぎる","quá …",2,"この先の展開を考えるとタイミングが悪すぎたとしか言いようがない。",[18,21]],["N4","〜ながら","vừa … vừa …",2,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[5,8]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",2,"祖母がまふる所長であることが悪いとは思わないし、自分はそうなんだと感じたくらいだ。",[21,24]],["N4","〜しか〜ない","chỉ … (mà thôi)",2,"この先の展開を考えるとタイミングが悪すぎたとしか言いようがない。",[22,31]],["N4","〜なければならない","phải …",1,"別に友達というのは相手の家庭環境を知らなければならないなんていうことは無いからね。",[19,26]],["N4","〜てくれる","(ai đó) làm … cho mình",1,"探偵、パティシエと、今の自分がいるのも後輩二人が自分を見つけてくれたこと。",[30,33]],["N4","〜てもらう","được (ai đó) làm … cho",1,"今大事なのは、みくるをどうすれば元気になってもらうかだ。",[21,25]],["N4","〜ように (mục đích)","để …",1,"あんながみくるの内面をどう見ているかと同じように、みくるがあんなの何を見ているのかが大事だ。",[21,25]],["N4","〜ので","vì … (lý do khách quan)",1,"彼が必死にミラージュの書の予言を回避しようと、変身のできない二人を揺さぶるのは無理があるんだ。",[25,27]],["N4","〜のに (dù)","dù … vậy mà",1,"彼女の視界にはみくるがいるはずなのに、この場面では距離感がある。",[16,19]],["N4","〜なら","nếu là … thì",1,"もしも話をしていたならば違った結果が待っていたはずだ。",[9,12]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"祖母がまふる所長であることが悪いとは思わないし、自分はそうなんだと感じたくらいだ。",[26,30]],["N4","〜ばかり","toàn là … / vừa mới …",1,"ニジーの精神を揺さぶるやり方には腹が立つし、偽者という悪意ある言葉には驚くばかりだ。",[37,40]],["N3","〜として","với tư cách là …",5,"真意に関係なく、みくるの心を揺さぶり、優位に立とうとしているのが分かる。",[25,28]],["N3","〜てほしい","muốn (ai) làm …",2,"みくるが何を語るのか、このモヤモヤを振り払って欲しい。",[22,25]],["N3","〜べき","nên / phải …",2,"真の心とは何か、嘘偽りのないあるべき自分をみくるはどう思うか。",[16,18]],["N3","〜に対して","đối với … / trái với …",1,"スターキラリングブローチを光らせた、くれあやるるかに対し、明ら様に気分が沈んでいるみくるが、祖母に語れない何かが今の時点では何も見えてこないんだ。",[25,28]],["N3","〜ばいい","chỉ cần … là được",1,"まふる所長とみくるの間で何らかの約束事があるのか、空気を重くしてあんなの同情を買い、視聴者の感情を揺さぶり次の一週間までどんな気持ちでいれば良いのか悩む。",[69,72]],["N3","〜ことで","bằng việc … / do …",1,"見る回数が増えていくごとに、みくるの嘘が大したことでは無いように思えてくる。",[23,26]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",1,"祖母がまふる所長であることが悪いとは思わないし、自分はそうなんだと感じたくらいだ。",[36,39]],["N3","〜にする (chọn)","chọn / quyết định là …",1,"あんなの前で狼狽える姿も、半年以上生活を共にした相棒の前で私の何を知っていると言うのは違う気がするんだ。",[21,24]],["N3","〜ところが","thế nhưng",1,"みくるの無力感には思うところがあるが、プリキュアとは何かを考えさせられる。",[11,15]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",2,"スターキラリングブローチの輝きは自分の心と向き合った時に反応をするものだろう。",[33,36]],["N2","〜上で","khi / trong việc … / sau khi …",1,"出会って半年以上で不安なことは吐き出して楽になれと言いたいのだろうが、探偵としての経験が避けて通れないと物語っているようでもある。",[7,9]],["N2","〜ようがない","không có cách nào …",1,"この先の展開を考えるとタイミングが悪すぎたとしか言いようがない。",[26,31]]],"glue":[[1,62,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[16,17],0],[2,50,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[18,19],0],[3,48,"真の心とは何か、嘘偽りのないあるべき自分をみくるはどう思うか。",[20,21],0],[4,55,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[6,7],0],[5,31,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[16,17],0],[6,76,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[2,3],0],[7,27,"今まで一度も語られてこなかった、みくるの母親と関係があるのか。",[22,23],0],[8,12,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[22,23],0],[9,1,"深く考えすぎて対象から外してしまった。",[9,11],0],[10,4,"今まで一度も語られてこなかった、みくるの母親と関係があるのか。",[1,3],0],[11,1,"あんなとは阿吽の呼吸で、マシュタンへのお土産のケーキの準備をしている。",[17,18],0],[13,26,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[15,16],0],[14,1,"怪盗団ファントムのウソノワールは気に留めていないが、デッチ・アゲインやニジーは楽観視はしていない。",[34,35],0],[15,46,"ハンニンダーは手強いのもあるが、今回はあんなとみくるは戦力外。",[12,14],0],[16,4,"でまかせでも探偵を困惑させる姿に惹かれるものがあります。",[25,27],0],[17,28,"この先の展開を考えるとタイミングが悪すぎたとしか言いようがない。",[20,21],0],[18,38,"今まで一度も語られてこなかった、みくるの母親と関係があるのか。",[11,15],0],[19,17,"ハンニンダーを目の前にして変身ができないあんなとみくる。",[12,13],0],[20,30,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[22,25],0],[21,2,"聞かれたくない話なのは察しはつくが、彼女の言葉としてあんなたちにどう伝えるのだろう。",[3,5],0],[22,15,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[25,27],0],[23,4,"でまかせでも探偵を困惑させる姿に惹かれるものがあります。",[12,14],0],[24,4,"今大事なのは、みくるをどうすれば元気になってもらうかだ。",[15,16],0],[26,2,"別に友達というのは相手の家庭環境を知らなければならないなんていうことは無いからね。",[19,27],0],[29,4,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[8,9],0],[30,2,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[5,8],0],[31,2,"スターキラリングブローチの四つの光を覚醒させないために、とどめを刺す。",[24,27],0],[32,1,"祖母がまふる所長であることが悪いとは思わないし、自分はそうなんだと感じたくらいだ。",[27,30],0],[34,2,"日頃の鬱憤をこの場でぶつけてくるとは実に彼らしい。",[21,24],0],[35,10,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[26,29],0],[37,14,"ハンニンダーは手強いのもあるが、今回はあんなとみくるは戦力外。",[7,10],0],[38,32,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[26,28],0],[39,20,"ハンニンダーは手強いのもあるが、今回はあんなとみくるは戦力外。",[14,15],0],[40,5,"表情が曇っているから、あんなでなくとも心配になるよ。",[8,10],0],[41,1,"彼女の視界にはみくるがいるはずなのに、この場面では距離感がある。",[16,18],0],[42,40,"もしも話をしていたならば違った結果が待っていたはずだ。",[14,15],0],[43,43,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[25,26],0],[44,5,"別に友達というのは相手の家庭環境を知らなければならないなんていうことは無いからね。",[4,7],0],[45,12,"去り際に、四つの光は我ら怪盗団ファントムのことだと言い切り探偵を追い詰める。",[24,27],0],[47,3,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[0,3],0],[49,1,"ジェット先輩がお菓子好きだから忘れていたけれど、他の妖精の食事事情はあまり語られていないことを思い出した。",[12,15],0],[50,1,"スターキラリングブローチの輝きは自分の心と向き合った時に反応をするものだろう。",[26,27],0],[53,1,"スターキラリングブローチを光らせた、くれあやるるかに対し、明ら様に気分が沈んでいるみくるが、祖母に語れない何かが今の時点では何も見えてこないんだ。",[25,28],0],[55,5,"真意に関係なく、みくるの心を揺さぶり、優位に立とうとしているのが分かる。",[25,28],0],[63,1,"公園の滑り台に宿ったマコトジュエルを華麗に盗もうと画策するのはウソノワール魂が根付いているのが伝わってきます。",[22,24],0],[65,1,"それにしてもハンニンダーにゲンコツを食らわせ、たんこぶを作ってしまう表現はかなり珍しいものだ。",[37,40],0],[69,1,"人は一人で生きようが、必ずどこかで誰かの真心に支えられている。",[11,13],0],[75,1,"ジェット先輩の報告を受け、パティスリーチュチュに来店したまふる所長。",[9,12],0],[77,19,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[25,27],0],[80,3,"表情が曇っているから、あんなでなくとも心配になるよ。",[24,25],0],[81,2,"別に友達というのは相手の家庭環境を知らなければならないなんていうことは無いからね。",[39,40],0],[82,3,"か細い声であんなと呼びかける声にはどんな気持ちが込められているのだろう。",[7,8],0],[90,5,"ジェット先輩の報告を受け、パティスリーチュチュに来店したまふる所長。",[10,13],0],[91,2,"大丈夫じゃないなんて悲しいことを言わないで。",[18,21],0],[92,5,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[17,21],0],[94,16,"今まで一度も語られてこなかった、みくるの母親と関係があるのか。",[9,11],0],[95,2,"書き終えてみて",[4,6],0],[97,2,"今大事なのは、みくるをどうすれば元気になってもらうかだ。",[21,25],0],[100,3,"彼女の視界にはみくるがいるはずなのに、この場面では距離感がある。",[13,15],0],[102,2,"真の心とは何か、嘘偽りのないあるべき自分をみくるはどう思うか。",[16,18],0],[103,9,"この先の展開を考えるとタイミングが悪すぎたとしか言いようがない。",[22,24],0],[104,1,"祖母がまふる所長であることが悪いとは思わないし、自分はそうなんだと感じたくらいだ。",[36,39],0],[105,2,"大丈夫じゃないなんて悲しいことを言わないで。",[7,10],0],[110,14,"今大事なのは、みくるをどうすれば元気になってもらうかだ。",[16,19],0],[111,4,"今大事なのは、みくるをどうすれば元気になってもらうかだ。",[1,4],0],[112,36,"毎度のことながら、このカメラ目線は誰が撮影しているのだろう。",[9,11],0],[113,3,"なぜプリキュアが怪盗の側にいるのか、疑問を投げかけ見捨てなかった。",[11,12],0],[114,3,"そして犯行前にマコトジュエルがバレてしまうのもお約束です。",[24,25],0],[115,6,"ハンニンダーを目の前にして変身ができないあんなとみくる。",[13,20],0]],"gseen":45,"read":[{"s":"みくるの無力感には思うところがあるが、プリキュアとは何かを考えさせられる。","c":[[["み","v","",""],["くる","v","",
impulsive","XUNG ĐỘNG ĐÍCH",1,1,""],["購入","こうにゅう","する：to purchase","CẤU NHẬP",1,0,""],["控える","ひかえる","to refrain, to restrain oneself, to wait (in another room)","KHỐNG",1,0,""],["意識","いしき","する：to be conscious [aware], to feel","Ý THỨC",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",6,"お手頃過ぎると言わざるを得ない価格でゴロゴロと存在しています。",[26,30]],["N5","〜が (nhưng)","nhưng",6,"故に…買うくらいには興味のあるゲームばかりではありますが、",[25,29]],["N5","〜てから","sau khi … rồi mới",2,"昨年ゲームを再開してから積み上げたゲームも結構あります。",[9,12]],["N4","〜ので","vì … (lý do khách quan)",9,"とりあえず、手持ちのPS3のゲームはほぼほぼ登録させたので、",[27,29]],["N4","〜すぎる","quá …",5,"お手頃過ぎると言わざるを得ない価格でゴロゴロと存在しています。",[3,6]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",5,"やっぱあの全てが全てポリポリしたゲーム機のことを少々好きになれないんですよね。",[29,33]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",4,"変な認識ができてしまっていると思われます。",[7,11]],["N4","〜てくる","… dần lên / … rồi đến",4,"でも…先ずはゲーム復帰以降に全然できてない据置型ゲーム機のＲＰＧ作品を",[16,19]],["N4","使役 〜させる","bắt / cho phép làm …",3,"とりあえず、手持ちのPS3のゲームはほぼほぼ登録させたので、",[24,27]],["N4","〜(よ)うと思う","định / tính làm …",2,"で、無理をして遊ぶものでもないだろうと思い、他に選択肢を探してみると‥‥",[16,20]],["N4","〜ようになる","trở nên (có thể) …",2,"中年になって‥‥宅トレするようになってから自分の活気も戻ってきましたが、",[13,18]],["N4","〜という","gọi là … / rằng …",2,"娯楽があり過ぎる（「ゲーム」という一分野のみでも）のも困りものだと思えます。",[14,17]],["N4","〜てもいい","… cũng được",1,"安くゲットでき（価値が低い）、いつでもできるゲーム（即やらなくても良い）…と、",[31,35]],["N4","〜なくてもいい","không cần … cũng được",1,"安くゲットでき（価値が低い）、いつでもできるゲーム（即やらなくても良い）…と、",[29,35]],["N4","〜てみる","thử làm …",1,"で、無理をして遊ぶものでもないだろうと思い、他に選択肢を探してみると‥‥",[30,33]],["N4","〜でしょう / 〜だろう","chắc là …",1,"で、無理をして遊ぶものでもないだろうと思い、他に選択肢を探してみると‥‥",[15,18]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"迷う程に娯楽が溢れてはいなかった（時代的にも財力的にも）のもありそうです。",[31,36]],["N4","〜ばかり","toàn là … / vừa mới …",1,"故に…買うくらいには興味のあるゲームばかりではありますが、",[18,21]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",4,"今もってスーファミが一番稼働率が高い（笑）くらいな私にとって、",[21,24]],["N3","〜として","với tư cách là …",3,"ずっとテレビゲームから離れていた者の感想として、",[20,23]],["N3","〜にとって","đối với (ai) …",2,"今もってスーファミが一番稼働率が高い（笑）くらいな私にとって、",[26,30]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",2,"つまらないわけでは無いのですが…イマイチ気分が乗らない。",[5,8]],["N3","〜ても / 〜でも (dù)","dù … cũng",2,"（ソフト自体は興味持てても、すべからくポリったゲーム環境自体がちょっと…）",[11,14]],["N3","〜に関して / 〜に関する","liên quan đến …",1,"（グラフィック面に関して）",[8,11]],["N3","〜続ける","tiếp tục …",1,"プレイし出すと…ある程度は遊べますが、長く１つ事に集中を続けることは難しい！",[28,31]],["N3","〜わけではない","không hẳn là …",1,"元々の現役時代の自分の遺産も多くあるわけではありますが、",[18,24]],["N3","〜ために (nguyên nhân)","vì …",1,"そのため、ゲームを楽に買えるのは良いのですが‥‥執着的なモノも薄れます。",[2,5]],["N2","〜上で","khi / trong việc … / sau khi …",1,"その上で有象無象な感じで興味対象が増えて分散しだすと‥‥なかなかに腰が重い！",[2,4]],["N2","〜ざるを得ない","buộc phải …",1,"お手頃過ぎると言わざるを得ない価格でゴロゴロと存在しています。",[9,15]],["N2","〜がち","hay … / thường có xu hướng",1,"（ソフト自体は興味持てても、すべからくポリったゲーム環境自体がちょっと…）",[30,32]],["N2","〜ことから","từ việc … (căn cứ)",1,"プレイならびにクリアすることから始めようかな～と思っています。",[12,16]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",1,"娯楽があり過ぎる（「ゲーム」という一分野のみでも）のも困りものだと思えます。",[29,32]]]}
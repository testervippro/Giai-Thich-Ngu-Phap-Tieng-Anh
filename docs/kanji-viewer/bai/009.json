",1,0,"ghep"],["無力","","vô (vô lý) + lực (Sức lực)","VÔ LỰC",1,0,"ghep"],["暴力","ぼうりょく","violence","BẠO LỰC",1,1,""],["中堅国連帯","","trung (Ở giữa) + kiên (kiên cố) + quốc (Quốc gia) + liên (Liên lạc) + đới (cái đai)","TRUNG KIÊN QUỐC LIÊN ĐỚI",1,1,"ghep"],["治安","","trị (Trị liệu) + an (an toàn; rẻ)","TRỊ AN",1,1,"ghep"],["両輪","","lưỡng (cả hai) + luân (bánh xe)","LƯỠNG LUÂN",1,1,"ghep"],["背景","はいけい","background, setting","BỐI CẢNH",1,0,""],["不利","","bất (không) + lợi (tiện lợi)","BẤT LỢI",1,1,"ghep"],["作る","つくる","to make, to produce","TÁC",1,0,""],["年以後","","niên (Năm) + dĩ (cái mốc) + hậu (Sau)","NIÊN DĨ HẬU",1,1,"ghep"],["祈る","いのる","to pray","KÌ",1,1,""],["弱い","よわい","weak, feeble, faint","NHƯỢC",1,0,""],["仕組","","sĩ (Công việc) + tổ (tổ chức)","SĨ TỔ",1,0,"ghep"],["自体","","tự (Tự tin) + thể (Cơ thể)","TỰ THỂ",1,0,"ghep"],["書く","かく","to write","THƯ",1,0,""],["位置","いち","position, location","VỊ TRÍ",1,0,""],["他人","たにん","other persons","THA NHÂN",1,0,""],["前提","ぜんてい","premise","TIỀN ĐỀ",1,0,""],["注視","","chú (chú ý) + thị (Thị lực)","CHÚ THỊ",1,1,"ghep"],["注目","ちゅうもく","する：to pay attention, to watch, to keep one's eyes on","TRÚ MỤC",1,0,""],["投票","とうひょう","する：to vote","ĐẦU PHIẾU",1,0,""],["未来","みらい","(the) future","VỊ LAI",1,0,""],["部分","ぶぶん","one portion, one part","BỘ PHÂN",1,0,""],["最後","さいご","the last, the end","TỐI HẬU",1,0,""],["一文","","nhất (Số 1) + văn (Văn học)","NHẤT VĂN",1,1,"ghep"],["引用","いんよう","する：to quote, to cite","DẪN DỤNG",1,0,""],["始まる","はじまる","to begin, to start, to commence (vi.)","THỦY",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",30,"どんな理由があれ侵略はNGという基本から離れすぎていることをだ。",[24,27]],["N5","〜たい","muốn làm …",6,"ここに異論のある人はここで引き返して自省してもらいたい。",[24,28]],["N5","〜が (nhưng)","nhưng",4,"だが、現代の兵器はそう簡単に増産できるものではない。",[0,3]],["N4","〜という","gọi là … / rằng …",21,"よくある誤認は「戦争を起こすと軍事産業が儲かる」というやつだ。",[24,27]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",20,"20世紀は貿易による相互利益が平和をもたらすと信じられてきた。",[25,28]],["N4","〜ので","vì … (lý do khách quan)",18,"私たちは今、移行期ではなく、断絶の真っただ中にいるのです。",[25,27]],["N4","〜てくる","… dần lên / … rồi đến",13,"20世紀は貿易による相互利益が平和をもたらすと信じられてきた。",[27,30]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",12,"理念と能力の隔たりは、あまりにも大きくなってしまいました。",[21,25]],["N4","〜でしょう / 〜だろう","chắc là …",6,"場合によっては、世界の大多数の国々がそこに加わることになるでしょう。",[29,33]],["N4","〜ようだ / 〜みたい","hình như / giống như …",6,"何十年もの間、カナダのような国々は、いわゆる「ルールに基づく国際秩序」の下で繁栄してきました。",[11,14]],["N4","〜ていく","… dần đi / … rồi đi",5,"そうして貿易、投資、文化の各分野に緊密なつながりの網を築いていくのです。",[29,32]],["N4","〜てもらう","được (ai đó) làm … cho",3,"ここに異論のある人はここで引き返して自省してもらいたい。",[21,25]],["N4","〜ながら","vừa … vừa …",3,"儀式には参加しながら、言葉と現実の隔たりをほとんど指摘せずにきました。",[7,10]],["N4","使役 〜させる","bắt / cho phép làm …",3,"短期決戦の間だけ持ちこたえればいいと独裁者に考えさせてしまった。",[24,27]],["N4","〜ことができる","có thể …",2,"その網を、将来の課題や機会に対応するために活用することができます。",[25,30]],["N4","〜ために","để … / vì …",2,"その網を、将来の課題や機会に対応するために活用することができます。",[18,21]],["N4","〜場合","trường hợp …",2,"場合によっては、世界の大多数の国々がそこに加わることになるでしょう。",[0,2]],["N4","〜しか〜ない","chỉ … (mà thôi)",2,"こうした大国の動きを中堅国が封じるには周りの中堅国と仲良くやっていくしかないのである。",[34,38]],["N4","〜てはいけない","không được …",1,"この前提をもって、我々は我々の政治や経済を注視しなくてはならない。",[26,32]],["N4","〜なければならない","phải …",1,"中堅国は協力して行動しなければなりません。",[11,19]],["N4","〜なくてはいけない / 〜なくちゃ","phải …",1,"この前提をもって、我々は我々の政治や経済を注視しなくてはならない。",[24,31]],["N4","〜予定","dự định …",1,"ドイツだけでも、今後数年間で数千億ユーロを投じる予定です。",[24,28]],["N4","〜ておく","làm sẵn, làm trước",1,"だからここでは陰謀論者を非難するだけでなく、まともな議論の話もしておきたい。",[32,35]],["N4","〜ように (mục đích)","để …",1,"私が繰り返し述べてきたように、そしてここでも改めて申し上げますが、私たちはドイツ連邦軍を可能な限り早く欧州最強の通常戦力を持つ軍隊にします。",[11,15]],["N4","〜ば (điều kiện)","nếu …",1,"交渉の席に着かなければ、食卓のメニューに載せられる側になるからです。",[9,12]],["N4","〜たら","nếu / khi … thì",1,"高市政権は戦争をしたがってるなんてバカみたいな陰謀論を撒き散らされてたら、実際になにをやろうとしてその妥当性がなにかなんて話をするところに辿り着けない。",[34,37]],["N4","〜なら","nếu là … thì",1,"もしモスクワが最終的に和平に同意するならば、それはこうした取り組みのおかげでもあるでしょう。",[18,21]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"しばらく前からちらほら流れてたのだけれども、その流れを見てればまあそりゃそうだろうという感想しかない。",[35,39]],["N4","〜すぎる","quá …",1,"どんな理由があれ侵略はNGという基本から離れすぎていることをだ。",[22,25]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"高市政権は戦争をしたがってるなんてバカみたいな陰謀論を撒き散らされてたら、実際になにをやろうとしてその妥当性がなにかなんて話をするところに辿り着けない。",[65,69]],["N4","〜ばかり","toàn là … / vừa mới …",1,"いわゆるFOIPの重要性も増すばかりだがこの話を突っ込んでるメディアもあまり見かけない。",[15,18]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",11,"20世紀は貿易による相互利益が平和をもたらすと信じられてきた。",[7,10]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",6,"もはや力を持たない選択肢はないというわけだ。",[18,21]],["N3","〜について","về …",5,"パートナーシップには、あらゆる価値観や利益について完全な一致が求められるわけではありません。",[21,25]],["N3","〜として","với tư cách là …",5,"私たちは今、その隔たりを埋めようとしています。",[16,19]],["N3","〜ほど","đến mức … / khoảng …",4,"私たちはモスクワに前例のないほどの損失と代償を強いてきました。",[14,16]],["N3","〜べき","nên / phải …",4,"これこそが2022年以後の世界で目指すべき平和の祈りだ。",[19,21]],["N3","〜にとって","đối với (ai) …",3,"日本にとっては他人事どころか、中心にあらざるを得ない課題なのである。",[2,6]],["N3","〜ことになる","được quyết định là / hoá ra là …",3,"場合によっては、世界の大多数の国々がそこに加わることになるでしょう。",[24,28]],["N3","〜ことで","bằng việc … / do …",3,"既存の国際機関に頼ることでもありません。",[10,13]],["N3","〜わけではない","không hẳn là …",2,"パートナーシップには、あらゆる価値観や利益について完全な一致が求められるわけではありません。",[36,42]],["N3","〜ばいい","chỉ cần … là được",2,"短期決戦の間だけ持ちこたえればいいと独裁者に考えさせてしまった。",[14,17]],["N3","〜おかげで","nhờ …",2,"もしモスクワが最終的に和平に同意するならば、それはこうした取り組みのおかげでもあるでしょう。",[34,38]],["N3","〜ずに","không … mà",2,"儀式には参加しながら、言葉と現実の隔たりをほとんど指摘せずにきました。",[28,30]],["N3","〜ないと","phải … (không thì)",2,"もはや力を持たない選択肢はないというわけだ。",[13,17]],["N3","〜に対して","đối với … / trái với …",1,"私たちは、ロシアの帝国主義に対して勇敢に抵抗するウクライナを支援しています。",[13,16]],["N3","〜に関して / 〜に関する","liên quan đến …",1,"私たちは、防空、長距離精密攻撃、衛星技術の各分野で、通常戦力に関する大規模な装備調達計画を開始しました。",[30,34]],["N3","〜ようとする","định / cố …",1,"私たちは今、その隔たりを埋めようとしています。",[14,18]],["N3","〜ばかりでなく / 〜だけでなく","không chỉ … mà còn",1,"だからここでは陰謀論者を非難するだけでなく、まともな議論の話もしておきたい。",[16,21]],["N3","〜ても / 〜でも (dù)","dù … cũng",1,"ドイツだけでも、今後数年間で数千億ユーロを投じる予定です。",[5,8]],["N3","〜続ける","tiếp tục …",1,"そこで私たちは、店先の窓に看板を掲げ続けたのです。",[18,21]],["N3","〜終わる","… xong",1,"今夜お話ししたいのは、世界秩序の断絶、心地よい虚構の終わり、そして大国間の地政学的な力関係が何の制約も受けなくなるという厳しい現実の到来についてです。",[26,29]],["N3","〜ために (nguyên nhân)","vì …",1,"、中国南海網も「南シナ海の主権範囲内での中国の必要な軍事防衛を強化するため、中国は、南シナ海島礁の面積を合理的に拡大した」と報道してるわけである。",[35,38]],["N3","〜にする (chọn)","chọn / quyết định là …",1,"私が繰り返し述べてきたように、そしてここでも改めて申し上げますが、私たちはドイツ連邦軍を可能な限り早く欧州最強の通常戦力を持つ軍隊にします。",[65,69]],["N2","〜に基づいて","dựa trên …",5,"つまり、共通の価値観や利益に基づき、課題ごとに異なる連携体制を構築しているのです。",[13,16]],["N2","〜に応じて","tuỳ theo …",1,"地球規模の問題の解決に向けて、課題に応じて参加国を変える柔軟な連携を追求しているのです。",[17,20]],["N2","〜にわたって","suốt / khắp …",1,"ちなみに、この分野において、ドイツと欧州は1年以上にわたり最も重要な主導的役割を果たしてきました。",[25,28]],["N2","〜に加えて","thêm vào …",1,"カナダ、日本、トルコ、インド、ブラジルに加え、南アフリカ、湾岸諸国、その他の国々が、この分野で重要な役割を果たすことになるでしょう。",[19,22]],["N2","〜ものの","tuy … nhưng",1,"私たちは、すべての懸念を共有しているわけではないものの、重要な懸念を共有する新たなパートナーとの関係を深めています。",[24,27]],["N2","〜ざるを得ない","buộc phải …",1,"日本にとっては他人事どころか、中心にあらざるを得ない課題なのである。",[20,26]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",1,"国際関係に「法の支配」をもたらすための正義と武力の背景になるものだ。",[30,33]],["N2","〜つつ","vừa … / tuy …",1,"これにより、依存関係やリスクを回避しつつ、双方にとって新たな選択肢や機会が生まれます。",[18,20]],["N1","〜をもって","bằng / vào lúc …",1,"この前提をもって、我々は我々の政治や経済を注視しなくてはならない。",[4,8]]]}
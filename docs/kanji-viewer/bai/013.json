,["思いつく","おもいつく","to think of, to hit on (an idea)","TƯ",1,0,""],["来年","らいねん","next year","LAI NIÊN",1,0,""],["以降","","dĩ (cái mốc) + giáng (xuống)","DĨ GIÁNG",1,0,"ghep"],["疲れる","つかれる","to be tired, to grow weary","BÌ",1,1,""],["都築","","đô (Kinh đô) + trúc (Kiến trúc)","ĐÔ TRÚC",1,1,"ghep"],["響一","","hưởng (Âm hưởng) + nhất (Số 1)","HƯỞNG NHẤT",1,1,"ghep"],["上條","","thượng (Bên trên)","THƯỢNG ?",1,1,"ghep"],["一輝","","nhất (Số 1) + huy (Huy hoàng)","NHẤT HUY",1,1,"ghep"],["創元社","","sáng (Sáng tạo) + nguyên (Nguyên khí) + xã (Xã hội)","SÁNG NGUYÊN XÃ",1,1,"ghep"],["体型","","thể (Cơ thể) + hình (địa hình)","THỂ HÌNH",1,0,"ghep"],["体重","たいじゅう","body weight","THỂ TRỌNG",1,0,""],["変わる","かわる","to change, to be altered, to vary, to be amended, to be revised (vi.)","BIẾN",1,0,""],["大学","だいがく","university, college","ĐẠI HỌC",1,0,""],["辞める","やめる","to resign, to quit","TỪ",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",26,"シャンデリアは川久が旅館だったころに使用されていたもの。",[22,25]],["N5","〜たい","muốn làm …",6,"性善説に基づいたこういうありよう、大切にしたいと思う。",[20,24]],["N5","〜が (nhưng)","nhưng",1,"今年は富山、清里、双葉町、横浜、山形、仙台とあちこち旅行したが、今回の白浜町で宿泊を伴う遠出は年内ラストとなる。",[29,32]],["N5","〜てから","sau khi … rồi mới",1,"そのあと日が出てから同行者と朝の散歩へ。",[7,10]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",24,"シャンデリアは川久が旅館だったころに使用されていたもの。",[20,23]],["N4","〜ので","vì … (lý do khách quan)",15,"南紀白浜空港行きの搭乗口は端っこのほうだったのでかなり歩かされた。",[22,24]],["N4","〜てくる","… dần lên / … rồi đến",6,"田辺湾に面した一等地に旅館川久ができたのは1949年。",[16,19]],["N4","〜ようだ / 〜みたい","hình như / giống như …",4,"*2:俺はそれが嫌で都内の大学を辞めたようなもんだから",[19,22]],["N4","〜ながら","vừa … vừa …",3,"かわいいサイズの飛行機を眺めながら、しばし搭乗案内を待った。",[14,17]],["N4","〜という","gọi là … / rằng …",3,"熊野白浜リゾート空港というのは愛称だそう。",[10,13]],["N4","〜しか〜ない","chỉ … (mà thôi)",3,"帰りの飛行機は夕方だったので、それまで時間を潰すには屋内施設しかない。",[30,34]],["N4","〜ていく","… dần đi / … rồi đi",2,"それは各センテンスの〈意味〉を累積的に伝えていくけれど、最初にフリースケッチがある文章においては、その〈星座〉が構造として伝わってくる。",[21,24]],["N4","〜ために","để … / vì …",2,"川久のために作られた特注品で世界最大サイズ。",[3,6]],["N4","〜と (điều kiện)","hễ … thì",2,"搭乗すると、強風で飛行機が揺れるためドリンクサービスは省略とのアナウンスが流れた。",[3,6]],["N4","〜ことができる","có thể …",1,"とくに南方熊楠記念館は2015年に行きたいと思いながら行けなかった場所だったので今回念願叶って行くことができてよかった。",[49,54]],["N4","〜ておく","làm sẵn, làm trước",1,"だからたこ焼き、唐揚げ、棒天に留めておいた。",[17,20]],["N4","〜てみる","thử làm …",1,"以前から一度泊まってみたいと憧れつつ、距離が遠いためになかなか思いきれなかったホテル川久に泊まってきた。",[9,12]],["N4","〜ようになる","trở nên (có thể) …",1,"パソコンで原稿を書くようになると線形の表象空間に塑型されがちになる。",[10,15]],["N4","〜かもしれない","có lẽ …",1,"俺はスルーしたがラーメンフェスをやっていたのでその影響もあったのかもしれない。",[32,36]],["N4","〜でしょう / 〜だろう","chắc là …",1,"そんな途方もないもの、そもそも建てる企業がないだろう。",[23,26]],["N4","〜はずだ","chắc chắn là … (theo lý)",1,"しかし計画では1900口販売して資金調達を図るはずが、実際に売れたのは431口のみ。",[23,25]],["N3","〜として","với tư cách là …",5,"旨い、が、かにやのケンキに似ている、と埼玉県在住者として思った。",[25,28]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",4,"1999年、カラカミ観光によって30億円で買収され現在にいたる。",[12,16]],["N3","〜ほど","đến mức … / khoảng …",3,"しかし哀しいかな、以前ほど量を食えない。",[11,13]],["N3","〜続ける","tiếp tục …",2,"10分近く滑走路を走っていたのでこのままずっと走り続けたら面白いな…と思ったら離陸した。",[25,28]],["N3","〜について","về …",1,"……ここで一旦流れを切って、ホテル川久についてパンフレットおよび都築響一『バブルの肖像』を参考に紹介したい。",[19,23]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",1,"*1:そのおかげで20代のころから現在まで、体型も体重もほぼ変わらずいられたわけだが",[38,41]],["N3","〜ようとする","định / cố …",1,"円安、インフレ、人手不足の今、同じ建物を建てようとしたらいくらかかることか。",[22,26]],["N3","〜終わる","… xong",1,"……以上、紹介終わり。",[7,10]],["N3","〜うちに","trong lúc … / trước khi …",1,"人がいないうちに館内の写真を撮りまくった。",[5,8]],["N3","〜おかげで","nhờ …",1,"*1:そのおかげで20代のころから現在まで、体型も体重もほぼ変わらずいられたわけだが",[5,9]],["N3","〜ことで","bằng việc … / do …",1,"おりしもバブル絶頂期のことである。",[11,14]],["N3","〜にする (chọn)","chọn / quyết định là …",1,"性善説に基づいたこういうありよう、大切にしたいと思う。",[19,22]],["N2","〜つつ","vừa … / tuy …",2,"行きたいと思いつつ今年行けなかった場所がいくつかあるので、それらは来年以降に持ち越す。",[7,9]],["N2","〜に基づいて","dựa trên …",1,"性善説に基づいたこういうありよう、大切にしたいと思う。",[3,6]],["N2","〜がち","hay … / thường có xu hướng",1,"パソコンで原稿を書くようになると線形の表象空間に塑型されがちになる。",[28,30]],["N2","〜としたら / 〜とすれば","giả sử …",1,"円安、インフレ、人手不足の今、同じ建物を建てようとしたらいくらかかることか。",[24,28]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",1,"*2:俺はそれが嫌で都内の大
"newly, again, on another time","CẢI",1,0,""],["確認","かくにん","する：to confirm","XÁC NHẬN",1,0,""],["壮絶","","tráng (cường tráng) + tuyệt (tuyệt đối)","TRÁNG TUYỆT",1,1,"ghep"],["好評","","hảo (Thích) + bình (Bình luận)","HẢO BÌNH",1,1,"ghep"],["奇跡","","kì (kì lạ) + tích (dấu tích)","KÌ TÍCH",1,0,"ghep"],["二度","","nhị (Số 2) + độ (lần)","NHỊ ĐỘ",1,0,"ghep"]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",12,"それができるならキングギドラと暴れている最中にもやれよ。",[17,20]],["N5","〜が (nhưng)","nhưng",6,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[12,15]],["N5","〜たい","muốn làm …",1,"まず映像面で言いたいのは、重力の影響がまるで感じられないのがいただけない。",[7,11]],["N5","〜から (lý do)","vì … nên",1,"山崎貴監督だってコピーを通じて「続編はやりません」宣言しているのだから、少しでも映画ファンだと自称する人は徹底的にこき下ろしてあげるのが武士の",[32,36]],["N5","〜前に","trước khi …",1,"り日本に犠牲が出ても別に知らんぷりって態度なら、キングギドラが滅ぼされる前に日本側の対策チームに妨害を仕掛けるくらいのことはやるだろう。",[35,38]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",21,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[16,19]],["N4","〜という","gọi là … / rằng …",9,"というか、それを納得させるためのガジェットをくれ。",[0,3]],["N4","〜でしょう / 〜だろう","chắc là …",8,"事実、村上の研究所には米兵が資料押収に向かってただろうが。",[24,27]],["N4","〜ていく","… dần đi / … rồi đi",7,"それでいくと娘が孤児院に置き去りにされるシーンも謎過ぎて。",[2,5]],["N4","使役 〜させる","bắt / cho phép làm …",6,"というか、それを納得させるためのガジェットをくれ。",[10,13]],["N4","〜てくる","… dần lên / … rồi đến",5,"さらにいうなら、典子を追いかけてきた敷島よ、お前、娘はどうした？",[15,18]],["N4","〜ので","vì … (lý do khách quan)",5,"もしかしたら壮絶な勘違いの末の好評だったのではないのかと。",[20,22]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",5,"今作を観てしまうと、前作でなぜ絶賛してしまったのか、改めて確認する必要さえ出てきそうな気がする。",[39,43]],["N4","〜ようだ / 〜みたい","hình như / giống như …",5,"着ぐるみ2体ががっぷり四つみたいなことにはなってない。",[13,16]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",4,"なんで娘を置き去りで夫婦2人が戦場にいっちゃうのよ。",[20,23]],["N4","〜なら","nếu là … thì",4,"さらにいうなら、典子を追いかけてきた敷島よ、お前、娘はどうした？",[5,8]],["N4","〜かもしれない","có lẽ …",2,"子どもと一緒でなければ出ていったかもしれない。",[16,20]],["N4","〜はずだ","chắc chắn là … (theo lý)",2,"こんな駄作に次回作の予算はつかないはずだ。",[17,19]],["N4","〜すぎる","quá …",2,"それでいくと娘が孤児院に置き去りにされるシーンも謎過ぎて。",[25,28]],["N4","〜てもいい","… cũng được",1,"いや、気象を使ってもいいが、その気象条件と予報は現在でも複雑で精度もそこまで高くない。",[8,12]],["N4","〜(よ)うと思う","định / tính làm …",1,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[24,28]],["N4","〜つもり","định …",1,"またゴジラでは新兵器に能書きたれといて無効なんてのはお家芸みたいものなので、そこに文句を言うつもりはない。",[46,49]],["N4","〜てある","(đã được ai đó) … sẵn",1,"百歩譲って破壊された銀座を大怪獣2体をぶつける舞台に設定したとして、現場指揮所に防護掩体もなしに設営するなんてあり得るか？",[54,57]],["N4","〜てあげる","làm … cho (người khác)",1,"しているのだから、少しでも映画ファンだと自称する人は徹底的にこき下ろしてあげるのが武士の情けではないかと思う。",[35,38]],["N4","〜てくれる","(ai đó) làm … cho mình",1,"娘が「迎えに来てくれるもん！",[7,10]],["N4","〜ために","để … / vì …",1,"それか、ブログで思い切り書くために心を入れ替えたか。",[14,17]],["N4","〜と (điều kiện)","hễ … thì",1,"今作を観てしまうと、前作でなぜ絶賛してしまったのか、改めて確認する必要さえ出てきそうな気がする。",[7,10]],["N4","〜かどうか","… hay không",1,"戦後の日本の技術でそこまで高い計画立案ができるのかどうか。",[24,28]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"せめて距離を取って観察できるポイントにいるとか、現場近くなら掩体をおいてケガしないところに置くとか、なんでもありそうなことを誰もしない、指摘もしない。",[41,45]],["N4","〜しか〜ない","chỉ … (mà thôi)",1,"-0.0は駄作としか言いようがない。",[8,17]],["N3","〜として","với tư cách là …",7,"ゴジラ誘導装置として、ゴジラ細胞を身に宿す浜辺美波演じる典子が作戦に志願する。",[7,10]],["N3","〜にする (chọn)","chọn / quyết định là …",3,"典子にしたって娘がいるから単身で作戦参加を決めたんじゃないの？",[2,5]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",2,"）によってキングギドラは討ち滅ぼされ、ゴジラを止める段になって米軍が艦砲射撃を含む集中砲火を浴びせる。",[1,5]],["N3","〜一方","mặt khác / ngày càng …",2,"絶賛の一方で辛口評価も…米批評家が指摘した前作との違いとは？",[3,6]],["N3","〜について","về …",1,"どうやってぶつけるのか、その具体策についても不問にしたとしよう。",[17,21]],["N3","〜に対して","đối với … / trái với …",1,"自然災害に匹敵する脅威に対して、有害駆除の熊か何かと同じ目線でゴジラやキングギドラを見ているんだろうか。",[11,14]],["N3","〜にとって","đối với (ai) …",1,"わたしにとっての「ゴジラ-0.0」はそういう作品になった。",[3,7]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",1,"というわけで、期待しつつ観てない人には悪いが、以降はネタバレで存分にいく。",[3,6]],["N3","〜ようとする","định / cố …",1,"当初はあなたを失いたくないと敷島と一緒に疎開しようとするが、ギドラに破壊された松本市を通過する際、その被害を目の当たりにして心変わりする。",[23,27]],["N3","〜っぽい","có vẻ / hơi …",1,"なんかドラマがあるっぽい、最初に集まったメンバーの大半が失踪する中でついてきたパイロットがあんな簡単に死んでいくのは、役者の無駄遣い。",[9,12]],["N3","〜てほしい","muốn (ai) làm …",1,"れる人間ドラマが映画を圧迫し、冗長な物語によって、ゴジラに早く再登場してほしいと思わせる」と批判している。",[35,38]],["N3","〜せいで","tại / do (lỗi)",1,"ヘタクソ脚本のせいで行動原理のよく分からない女性になってしまっているが、それでも作中ではまだしも説得力のあるキャラクターだった。",[7,10]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",1,"度なら、キングギドラが滅ぼされる前に日本側の対策チームに妨害を仕掛けるくらいのことはやるだろう。",[35,38]],["N3","〜ないと","phải … (không thì)",1,"そりゃ、そうなるよねってなるので、同情の余地がないというか、こいつらゴジラもキングギドラもナメてんなっていうか。",[23,27]],["N2","〜を通じて / 〜を通して","thông qua …",1,"山崎貴監督だってコピーを通じて「続編はやりません」宣言しているのだから、少しでも映画ファンだと自称",[11,14]],["N2","〜上で","khi / trong việc … / sau khi …",1,"また、米大手通信社AP通信の映画批評家ジェイク・コイル氏も「地上で繰り広げられる人間ドラマが映画を圧迫し、冗長な物語によって、ゴジラに早",[31,33]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",1,"すごく飲み込みづらい、山崎貴の脚本、および監督を信じて全力投球した結果、一蓮托生で爆死したようなものだ。",[48,51]],["N2","〜ようがない","không có cách nào …",1,"-0.0は駄作としか言いようがない。",[12,17]],["N2","〜つつ","vừa … / tuy …",1,"というわけで、期待しつつ観てない人には悪いが、以降はネタバレで存分にいく。",[10,12]]],"glue":[[1,46,"実際、大怪獣の激突で飛来物があり、指揮所スタッフは負傷する。",[24,25],0],[2,48,"実際、大怪獣の激突で飛来物があり、指揮所スタッフは負傷する。",[13,14],0],[3,39,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[14,15],0],[4,49,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[9,10],0],[5,43,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[14,15],0],[6,57,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[12,13],0],[7,29,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[20,21],0],[8,20,"絶賛の一方で辛口評価も…米批評家が指摘した前作との違いとは？",[10,11],0],[9,4,"これもまたヘンな話で、前作から2年経つのが本作の時間軸。",[13,15],0],[10,2,"戦後の日本の技術でそこまで高い計画立案ができるのかどうか。",[11,13],0],[13,23,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[17,18],0],[14,3,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[7,8],0],[15,55,"実際、大怪獣の激突で飛来物があり、指揮所スタッフは負傷する。",[27,29],0],[16,2,"さっきの娘置いてきますシーケンスは必要だったんか？",[9,11],0],[17,42,"絶賛の一方で辛口評価も…米批評家が指摘した前作との違いとは？",[20,21],0],[19,25,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[26,28],0],[20,1,"山崎貴監督だってコピーを通じて「続編はやりません」宣言しているのだから、少しでも映画ファンだと自称する人は徹底的にこき",[21,24],0],[22,30,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[4,5],0],[23,12,"それができるならキングギドラと暴れている最中にもやれよ。",[17,20],0],[24,3,"戦争孤児の悲惨さを言いたかったのか何なのか、いるか、このシーン？",[11,14],0],[25,23,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[17,19],0],[26,6,"というか、それを納得させるためのガジェットをくれ。",[11,13],0],[27,1,"嘘くさいといえば米軍もおかしい。",[7,8],0],[28,3,"もしかしたら壮絶な勘違いの末の好評だったのではないのかと。",[4,6],0],[29,8,"さらにいうなら、典子を追いかけてきた敷島よ、お前、娘はどうした？",[5,7],0],[30,5,"接触した瞬間、爆発するように破壊する光線が間近に通過しても何ともないのが不思議。",[27,29],0],[31,1,"子どもと一緒でなければ出ていったかもしれない。",[7,11],0],[32,1,"いや、気象を使ってもいいが、その気象条件と予報は現在でも複雑で精度もそこまで高くない。",[8,12],0],[34,5,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[25,26],0],[36,2,"それか、ブログで思い切り書くために心を入れ替えたか。",[14,17],0],[37,5,"今作を観てしまうと、前作でなぜ絶賛してしまったのか、改めて確認する必要さえ出てきそうな気がする。",[40,43],0],[38,8,"まるでレーザーか何かのように振動も何も影響が感じられない。",[11,14],0],[40,8,"事実、村上の研究所には米兵が資料押収に向かってただろうが。",[24,27],0],[41,2,"子どもと一緒でなければ出ていったかもしれない。",[16,20],0],[42,10,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[0,2],0],[43,1,"いや、気象を使ってもいいが、その気象条件と予報は現在でも複雑で精度もそこまで高くない。",[38,42],0],[44,1,"いや、浜辺美波はよかった。",[8,12],0],[45,29,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[25,26],0],[46,14,"もしかしたら壮絶な勘違いの末の好評だったのではないのかと。",[21,25],0],[47,1,"しかしさすがにゴジラvsキングギドラの対決シーンは圧巻。",[0,3],0],[48,1,"そしてケガする。",[0,3],0],[49,4,"これもまたヘンな話で、前作から2年経つのが本作の時間軸。",[3,5],0],[50,2,"結局、ゴジラ細胞を宿す典子は作戦終了後も米軍に追われる身となり、夫婦で逃亡生活は過酷だから娘は置いていこう、最後に挨拶だけしようと孤児院に寄る。",[42,45],0],[51,14,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[28,29],0],[52,10,"典子にしたって娘がいるから単身で作戦参加を決めたんじゃないの？",[11,13],0],[56,1,"どうやってぶつけるのか、その具体策についても不問にしたとしよう。",[17,21],0],[57,30,"絶賛の一方で辛口評価も…米批評家が指摘した前作との違いとは？",[20,21],0],[58,23,"もしかしたら壮絶な勘違いの末の好評だったのではないのかと。",[20,21],0],[59,10,"絶賛の一方で辛口評価も…米批評家が指摘した前作との違いとは？",[23,25],0],[60,15,"がんばって全部観るには観たが、途中で何度も退席しようと思った。",[26,29],0],[61,1,"自然災害に匹敵する脅威に対して、有害駆除の熊か何かと同じ目線でゴジラやキングギドラを見ているんだろうか。",[11,14],0],[62,2,"）によってキングギドラは討ち滅ぼされ、ゴジラを止める段になって米軍が艦砲射撃を含む集中砲火を浴びせる。",[1,4],0],[63,7,"ゴジラ誘導装置として、ゴジラ細胞を身に宿す浜辺美波演じる典子が作戦に志願する。",[7,10],0],[66,1,"わたしにとっての「ゴジラ-0.0」はそういう作品になった。",[3,6],0],[70,1,"ヘタクソ脚本のせいで行動原理のよく分からない女性になってしまっているが、それでも作中ではまだしも説得力のあるキャラクターだった。",[44,46],0],[71,1,"敷島演じる神木隆之介の方はもうあきらめたのだろう。",[13,15],0],[75,1,"さらにいうなら、典子を追いかけてきた敷島よ、お前、娘はどうした？",[0,3],0],[83,1,"前作の評価を受け、公開前からすごい期待の高まることとなった「ゴジラ-0.0」だったが、開始まもなく不安がよぎった。",[5,8],0],[85,10,"そういう間抜けを映画文脈の中でやられるとまじ興ざめなんだが。",[26,28],0],[86,1,"なんで娘を置き去りで夫婦2人が戦場にいっちゃうのよ。",[20,23],0],[87,6,"こいつらゴジラやキングギドラを害獣か何かと勘違いしてないか？",[25,26],0],[88,5,"さらにいうなら、典子を追いかけてきた敷島よ、お前、娘はどうした？",[20,21],0],[89,2,"でしょうね。",[4,5],0],[93,1,"まず映像面で言いたいのは、重力の影響がまるで感じられないのがいただけない。",[30,33],0]],"gseen":60,"read":[{"s":"がんばって全部観るには観たが、途中で何度も退席しようと思った。","c":[[["がんばっ","v","",""],["て","p","",""]],[["全部","n","TOÀN BỘ","all, whole"],["観る","v","QUAN","quan sát"],["に","p","",""],["は","p","",""]],[["観","v","QUAN","quan sát"],["た","v","",""],["が","p","",""],["、","o","",""]],[["途中","n","ĐỒ TRUNG","on the way, midway"],["で","p","",""]],[["何","n","HÀ","what"],["度","n","ĐỘ","lần"],["も","p","",""]],[["退席","n","THOÁI TỊCH","する：to leave one's seat [the room]"],["しよ","v","",""],["う","v","",""],["と","p","",""]],[["思っ","v","TƯ","to think, to guess"],["た","v","",""]]],"g":[[1,10,11],[4,9,10],[5,17,18],[8,20,21],[15,7,9],[17,12,13],[17,29,30],[22,4,5],[34,25,26],[51,13,14],[60,26,29]],"v":[[0,5,22,[],"Mình đã cố","I tried hard and"],[5,15,51,[],"xem hết thì cũng xem hết,","I did watch it all,"],[15,31,null,[],"nhưng giữa chừng đã mấy lần định bỏ ra về.","but I thought about leaving many times midway."]],"vi":"Mình đã cố xem hết, nhưng giữa chừng đã mấy lần định bỏ ra về.","en":"I did manage to watch it all, but I thought about leaving many times midway."},{"s":"もしかしたら壮絶な勘違いの末の好評だったのではないのかと。","c":[[["もしか","o","",""],["し","v","",""],["たら","v","",""]],[["壮絶","n","TRÁNG TUYỆT","cường tráng + tuyệt đối"],["な","v","",""],["勘違い","n","KHÁM VI","する：to misunderstand, to misinterpret"],["の","p","",""],["末","n","MẠT","cuối cùng"],["の","p","",""],["好評","n","HẢO BÌNH","thích + bình luận"],["だっ","v","",""],["た","v","",""],["の","n","",""],["で","v","",""],["は","p","",""]],[["ない","v","",""],["の","n","",""],["か","p","",""],["と","p","",""]]],"g":[[6,12,13],[6,14,15],[7,27,28],[13,26,27],[28,4,6],[45,8,9],[45,17,20],[46,21,25],[58,20,21],[58,25,26]],"v":[[0,6,28,[],"Không chừng","Maybe"],[6,29,null,[["の","勘違いの末","末 của 勘違い"],["の","末の好評","好評 của 末"]],"những lời khen đó là kết quả của một sự hiểu lầm khủng khiếp chăng.","the good reviews came from some terrible misunderstanding."]],"vi":"Không chừng những lời khen 
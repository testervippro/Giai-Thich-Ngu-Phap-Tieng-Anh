0,""],["調子","","điều (Điều tra) + tử (Con)","ĐIỀU TỬ",1,0,"ghep"],["何時","なんじ","what time","HÀ THỜI",1,0,""],["狂気","きょうき","madness, insanity","CUỒNG KHÍ",1,1,""],["沙汰","","sa (Sa thải) + thải (chất thải)","SA THẢI",1,1,"ghep"],["家庭","かてい","one's home","GIA ĐÌNH",1,0,""],["課","か","section, department","KHOÁ",1,0,""],["目減","","mục (Mắt) + giảm (giảm xuống)","MỤC GIẢM",1,1,"ghep"],["大事な","だいじな","important, critical","ĐẠI SỰ",1,0,""],["話す","はなす","to talk, to tell, to speak","THOẠI",1,0,""],["結構","","kết (kết hôn) + cấu (cấu tạo)","KẾT CẤU",1,0,"ghep"],["積む","つむ","to load, to pile up","TÍCH",1,0,""],["山","やま","mountain","SƠN",1,0,""],["余裕","よゆう","leeway, spare (time, money, etc.)","DƯ DỤ",1,0,""],["奪う","うばう","to snatch away, to take (a thing) by force","ĐOẠT",1,0,""],["文字","もじ","letter (of the alphabet, etc.)","VĂN TỰ",1,0,""],["通り","とおり","street","THÔNG",1,0,""],["忙殺される","ぼうさつされる","to be very busy (with work) ♢","MANG SÁT",1,0,""],["存在","そんざい","する：to exist, to be","TỒN TẠI",1,0,""],["入れる","いれる","to put in [into], to let in","NHẬP",1,0,""],["精一杯楽","","tinh (Tinh luyện) + nhất (Số 1) + bôi (cái chén) + lạc, nhạc (âm nhạc, vui)","TINH NHẤT BÔI LẠC, NHẠC",1,1,"ghep"],["結果","けっか","result, consequence","KẾT QUẢ",1,0,""],["状況","","trạng (Trạng thái) + huống (Tình huống)","TRẠNG HUỐNG",1,0,"ghep"],["種","たね","seed","CHỦNG",1,0,""],["与件","","dự (ban cho) + kiện (Sự kiện)","DỰ KIỆN",1,1,"ghep"],["物事","ものごと","things, all things, everything","VẬT SỰ",1,0,""],["整理","せいり","する：to arrange, to reorganise","CHỈNH LÝ",1,0,""],["物","もの","thing, object, substance, article","VẬT",1,0,""],["凄い","すごい","horrible, terrible, superb, fantastic, tremendous, awful","THÊ",1,0,""],["羨望","せんぼう","する：to be envious of","TIỆN VỌNG",1,1,""],["向ける","むける","to turn something (to)","HƯỚNG",1,0,""],["選ぶ","えらぶ","to choose, to select, to elect","TUYỂN",1,0,""],["境遇","","cảnh (cảnh giới) + ngộ (hội ngộ)","CẢNH NGỘ",1,0,"ghep"],["見出","","kiến (Nhìn) + xuất (ra ngoài)","KIẾN XUẤT",1,0,"ghep"],["推し量る","おしはかる","to guess, to conjecture","SUY LƯỢNG",1,1,""],["長い","ながい","long","TRƯỜNG",1,0,""],["別の","べつの","different, separate, another","BIỆT",1,0,""],["機会","きかい","opportunity, occasion","CƠ HỘI",1,0,""],["部分","ぶぶん","one portion, one part","BỘ PHÂN",1,0,""],["糊塗","","đồ (sơn)","? ĐỒ",1,1,"ghep"],["基づく","もとづく","to be based on","CƠ",1,0,""],["医療","","y (Y tế) + liệu (trị liệu)","Y LIỆU",1,1,"ghep"],["手続き","てつづき","procedures, formalities","THỦ TỤC",1,0,""],["偉大な","いだいな","great, grand","VĨ ĐẠI",1,0,""],["主軸","","chủ (Ông chủ) + trục (Cái trục xe)","CHỦ TRỤC",1,0,"ghep"],["据える","すえる","to put into position, to set, to place, to lay, to install","CƯ",1,1,""],["当然","とうぜん","naturally, as a matter of course","ĐƯƠNG NHIÊN",1,0,""],["機敏","","cơ (cơ khí, máy móc) + mẫn (Mẫn cảm)","CƠ MẪN",1,1,"ghep"],["時期","","thời (Thời gian) + kì (kì hạn)","THỜI KÌ",1,0,"ghep"],["枯れる","かれる","to wither","KHÔ",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",26,"無駄を許容すること自体、「若さ」や「健康」に依存している",[25,28]],["N5","〜が (nhưng)","nhưng",3,"だが、面白いとかつまんねーとかいった話に関しては脅威だ。",[0,3]],["N5","〜から (lý do)","vì … nên",1,"そのうえ高河ゆんさんと同じような活動限界の問題まで抱えているのだから、23時を過ぎてキーボードを叩きたい時もぐっと堪えるのが常になってしまっている。",[31,35]],["N5","〜てから","sau khi … rồi mới",1,"ところが上掲noteを読んでから数時間後、就寝直前になって「これって、大人がつまらなくなっていくプロセスと関係があるんじゃないかなぁ」とか考えはじめてしまった。",[13,16]],["N4","〜てくる","… dần lên / … rồi đến",12,"書いてみたら面白いだろうなって思うことは23時以降に降りて来る。",[28,30]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",10,"じゃあさ、年を取ってしまうってのは、つまんねーことなのかなぁ？",[9,13]],["N4","〜でしょう / 〜だろう","chắc là …",9,"書いてみたら面白いだろうなって思うことは23時以降に降りて来る。",[9,12]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",8,"必要そうな読書ばかりやっているとつまんなくなってくる。",[1,5]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",7,"きっとそれは、（色々な意味で）選ばれた人にしかできないことなんだろうと思う。",[16,19]],["N4","〜と (điều kiện)","hễ … thì",6,"活動時間が短くなり、「選択と集中」を意識して効率的に仕事に取り組んでいると、仕事以外の活動、遊びに相当する活動がやせ細ってくる。",[35,38]],["N4","〜ようだ / 〜みたい","hình như / giống như …",5,"つまんねーみたいなことを思うようになったら、そうするのが一番だ。",[5,8]],["N4","〜という","gọi là … / rằng …",5,"それって作業効率という点ては最良かもしれないけど、なんだかつまらないよね。",[8,11]],["N4","〜ばかり","toàn là … / vừa mới …",5,"必要そうな読書ばかりやっているとつまんなくなってくる。",[7,10]],["N4","〜てみる","thử làm …",4,"書いてみたら面白いだろうなって思うことは23時以降に降りて来る。",[2,5]],["N4","〜ていく","… dần đi / … rồi đi",4,"仕事の種類にもよるが、基本的に、仕事一色のライフスタイルは人間をつまんない方向に持っていきやすいように思う。",[42,45]],["N4","〜なければならない","phải …",3,"そうでない尺度で自他を推し量らなければならない。",[15,22]],["N4","〜ので","vì … (lý do khách quan)",3,"が、思ったより文章が長くなってしまったのでそれはまた別の機会に。",[19,21]],["N4","〜すぎる","quá …",3,"遊びに限らず、効率至上主義が行き過ぎるとやっぱりつまんなくなるんじゃないだろうか。",[16,19]],["N4","〜ために","để … / vì …",2,"この問題を避けるためには、無駄を許容し「あそび」をもうけるのが一番だ。",[8,11]],["N4","〜たら","nếu / khi … thì",2,"つまんねーみたいなことを思うようになったら、そうするのが一番だ。",[19,22]],["N4","〜しか〜ない","chỉ … (mà thôi)",2,"きっとそれは、（色々な意味で）選ばれた人にしかできないことなんだろうと思う。",[21,27]],["N4","〜てはいけない","không được …",1,"中年や老年の境遇に面白さを見出すとしたら、若かった頃の尺度ではだめだ。",[29,33]],["N4","〜ことができる","có thể …",1,"私はそうしたものを「深夜のインターネットの妖精」と呼んでいるけれども、早寝早起きをしていると、この妖精さんの力を借りることができない。",[59,64]],["N4","〜(よ)うと思う","định / tính làm …",1,"きっとそれは、（色々な意味で）選ばれた人にしかできないことなんだろうと思う。",[32,36]],["N4","〜つもり","định …",1,"実際、自分は今までそうしてきたつもりだった。",[15,18]],["N4","〜てくれる","(ai đó) làm … cho mình",1,"冒頭リンク先の文章もそのことをよく教えてくれる。",[19,22]],["N4","〜ようになる","trở nên (có thể) …",1,"つまんねーみたいなことを思うようになったら、そうするのが一番だ。",[14,19]],["N4","〜ようにする","cố gắng để …",1,"私はこれを怖れているので意識的に遊びに相当する活動をやるようにしていて、このブログもその一環なんだけど、切羽詰まってくると本当に遊びができなくなる。",[28,32]],["N4","〜ように (mục đích)","để …",1,"さっき触れたように、深夜に書く文章には深夜にしか宿らない面白さがある、と思う。",[6,10]],["N4","〜かもしれない","có lẽ …",1,"それって作業効率という点ては最良かもしれないけど、なんだかつまらないよね。",[16,20]],["N4","〜やすい","dễ …",1,"仕事の種類にもよるが、基本的に、仕事一色のライフスタイルは人間をつまんない方向に持っていきやすいように思う。",[45,48]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"効率性を度外視し、それぞれのジャンルのおいしそうなところにとらわれすぎず、裾野にもきちんと手を突っ込むこと・みてまわることで救われるものがある。",[25,29]],["N3","〜として","với tư cách là …",7,"でも、たとえばユーモアのような機敏は「つまんねー」が影を落としている時期は枯れるように思う。",[29,32]],["N3","〜ても / 〜でも (dù)","dù … cũng",6,"自分自身を省みても、第三者から見てもきっとそうだろう。",[7,10]],["N3","〜ことで","bằng việc … / do …",3,"ジャンルの裾野をぶらぶらするとは、時間のかかることでもある。",[23,26]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",2,"若い頃にもエコノミークラス症候群などのリスクがないわけではないが、中年期や老年期におけるリスクはそれよりずっと上だ。",[25,28]],["N3","〜ばかりでなく / 〜だけでなく","không chỉ … mà còn",2,"原稿を書くことだけでなく、たぶん精神科の診療面接においてさえそうだ。",[7,12]],["N3","〜ところが","thế nhưng",2,"ところが五十代になった今、それも難しくなってきている。",[0,4]],["N3","〜にとって","đối với (ai) …",1,"そうして文字通り忙殺されてしまえば中年は自他にとってつまらない存在になるから、せめて余暇や遊びを入れようとするわけだが、そ",[22,26]],["N3","〜に関して / 〜に関する","liên quan đến …",1,"だが、面白いとかつまんねーとかいった話に関しては脅威だ。",[19,22]],["N3","〜ことになる","được quyết định là / hoá ra là …",1,"もうとした結果として効率至上主義の罠に落ちる……みたいな状況が生まれることになる。",[35,39]],["N3","〜ようとする","định / cố …",1,"えば中年は自他にとってつまらない存在になるから、せめて余暇や遊びを入れようとするわけだが、そこにも限界があり、少ない時間で精一杯楽しもうとした結果と",[35,39]],["N3","〜はじめる / 〜始める","bắt đầu …",1,"ところが上掲noteを読んでから数時間後、就寝直前になって「これって、大人がつまらなくなっていくプロセスと関係があるんじゃないかなぁ」とか考えはじめてしまった。",[71,75]],["N3","〜わけではない","không hẳn là …",1,"若い頃にもエコノミークラス症候群などのリスクがないわけではないが、中年期や老年期におけるリスクはそれよりずっと上だ。",[25,31]],["N3","〜うちに","trong lúc … / trước khi …",1,"昔はユーモアもアイデアもいっぱいだった人が、仕事に追われるうちにそうした色艶を失っていったり、SNSで吹かしている扇動家の劣化コピーに",[29,32]],["N3","〜ほど","đến mức … / khoảng …",1,"仕事においても家庭においても課される役割が増えるほど、余暇と呼んで良い時間が目減りしてしまう。",[24,26]],["N3","〜ずに","không … mà",1,"らする行為がかなりしんどくなる、というか生活や活動全体の効率性を脅かさずにぶらぶらするのが次第に難しくなってくる。",[35,37]],["N3","〜べき","nên / phải …",1,"それを踏まえてこれからは生きる、というお話は前向きに理解するべきものだと思う。",[30,32]],["N2","〜ざるを得ない","buộc phải …",2,"20代の頃の調子で深夜に何時間もオンラインゲームをやっているとか、狂気の沙汰といわざるを得ない。",[41,47]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",2,"それを踏まえてこれからは生きる、というお話は前向きに理解するべきものだと思う。",[32,35]],["N2","〜に基づいて","dựa trên …",1,"この点において操作的診断基準、エビデンスに基づいた精神医療の手続きとは偉大なものだと思うし、それを主軸に据えるのは当然だとも思う。",[20,23]],["N2","〜に限らず","không chỉ …",1,"遊びに限らず、効率至上主義が行き過ぎるとやっぱりつまんなくなるんじゃないだろうか。",[2,6]],["N2","〜っぱなし","để nguyên / … suốt",1,"そもそもディスプレイの前で座りっぱなしでいること自体、中年期以降には脅威なのだ。",[15,19]],["N2","〜次第","ngay khi / tuỳ vào …",1,"んどくなる、というか生活や活動全体の効率性を脅かさずにぶらぶらするのが次第に難しくなってくる。",[35,37]],["N2","〜としたら / 〜とすれば","giả sử …",1,"中年や老年の境遇に面白さを見出すとしたら、若かった頃の尺度ではだめだ。",[16,20]],["N2","〜ようがない","không có cách nào …",1,
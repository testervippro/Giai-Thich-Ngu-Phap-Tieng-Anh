 to be revised (vi.)","BIẾN",1,0,""],["驚く","おどろく","to be surprised","KINH",1,0,""],["建物","たてもの","a building","KIẾN VẬT",1,0,""],["右","みぎ","right","HỮU",1,0,""],["凡庸な","ぼんような","mediocre, ordinary, common","PHÀM DUNG",1,1,""],["白身","","bạch (Màu trắng) + thân (Bản thân)","BẠCH THÂN",1,1,"ghep"],["豚肉","ぶたにく","pork","ĐỒN NHỤC",1,1,""],["令和","","lệnh (Mệnh lệnh) + hòa (Hòa bình)","LỆNH HÒA",1,0,"ghep"],["食う","くう","to eat","THỰC",1,0,""],["涙","なみだ","teardrop, tears","LỆ",1,0,""],["特に","とくに","specially, particularly","ĐẶC",1,0,""],["不味","","bất (không) + vị (Hương vị)","BẤT VỊ",1,1,"ghep"],["積極的","","tích (Tích trữ) + cực (cực đoan) + đích (Mục đích)","TÍCH CỰC ĐÍCH",1,0,"ghep"],["文句","もんく","grumblings, complaints, a phrase [series] of words","VĂN CÚ",1,0,""],["青春時代","せいしゅんじだい","youth, springtime of life","THANH XUÂN THỜI ĐẠI",1,0,""],["親","おや","parent(s)","THÂN",1,0,""],["料理","りょうり","cooking, food","LIỆU LÝ",1,0,""],["普段","","phổ (phổ thông) + đoạn (giai đoạn)","PHỔ ĐOẠN",1,0,"ghep"],["表参道","","biểu (phát biểu) + tham (tham gia; viếng) + đạo (Đường đi)","BIỂU THAM ĐẠO",1,1,"ghep"],["名乗","","danh (Tên) + thừa (lên xe)","DANH THỪA",1,0,"ghep"],["名前","なまえ","name","DANH TIỀN",1,0,""],["付く","つく","to be attached, to stick to","PHÓ",1,0,""],["頼む","たのむ","to ask (a favour), to request","LẠI",1,0,""],["日青山学院","","nhật (Ngày) + thanh (Màu xanh) + sơn (Núi) + học (Học sinh) + viện (Bệnh viện)","NHẬT THANH SƠN HỌC VIỆN",1,1,"ghep"],["東京都","とうきょうと","Tokyo Metropolis","ĐÔNG KINH ĐÔ",1,0,""],["区","く","ward","KHU",1,1,""],["中","なか","the inside, in the middle","TRUNG",1,0,""]],"grammar":[["N5","〜が (nhưng)","nhưng",5,"青学といえば、最近は箱根駅伝で有名ですが、昔から野球部が強いんです。",[17,21]],["N5","〜たい","muốn làm …",2,"コレちゃんがやりたいのは、馬術部と青山猫愛好会とKPOPダンスでした。",[7,11]],["N5","〜てください","hãy làm … (nhờ, yêu cầu lịch sự)",1,"そんなシャバい名前を付ける前に、頼むから味をアップデートしてください。",[29,33]],["N5","〜前に","trước khi …",1,"そんなシャバい名前を付ける前に、頼むから味をアップデートしてください。",[12,15]],["N5","〜てから","sau khi … rồi mới",1,"「あたしが死んでも」と「たばこ」のしっとりタイムを過ごしてからトークの時間。",[28,31]],["N4","〜ので","vì … (lý do khách quan)",11,"なので、修学旅行に2回行かされたという輝かしい実績があります。",[1,3]],["N4","〜という","gọi là … / rằng …",8,"今回のライブは私の母校というのもあって、とっても感慨深くて。",[11,14]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",6,"そのあとも「ぷんぷん」からの「もうすぐ大人になっちゃうから」までアクセルずっと全開。",[24,27]],["N4","〜すぎる","quá …",6,"ちなみに私は高校2年のとき、ふざけすぎてたら本当に留年しました。",[17,20]],["N4","〜てくる","… dần lên / … rồi đến",4,"しかも青山学院講堂でやってくれたのが、すっごく感情を揺さぶられました。",[12,15]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",4,"コレちゃんのコラボステージって、あんま見たことないし、今回は学生コラボ。",[24,27]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",4,"なので、修学旅行に2回行かされたという輝かしい実績があります。",[13,16]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",3,"コレちゃんが留年しそうな人にコールを呼び掛けたら、めちゃくちゃ多かった。",[8,12]],["N4","〜ようだ / 〜みたい","hình như / giống như …",3,"「やってみたい贅沢は？",[4,7]],["N4","〜らしい","có vẻ / đúng chất …",3,"」のコールを畳みかけさせる素晴らしい流れ。",[15,18]],["N4","〜てみる","thử làm …",2,"「やってみたい贅沢は？",[3,6]],["N4","〜てくれる","(ai đó) làm … cho mình",2,"しかも青山学院講堂でやってくれたのが、すっごく感情を揺さぶられました。",[12,15]],["N4","〜と (điều kiện)","hễ … thì",2,"経験者から言わせると、留年するなら高校がおすすめ。",[8,11]],["N4","〜ながら","vừa … vừa …",2,"ホルツをやりながら学祭でも最高のテンションですげえなって感動しきり。",[6,9]],["N4","使役 〜させる","bắt / cho phép làm …",2,"経験者から言わせると、留年するなら高校がおすすめ。",[6,9]],["N4","〜てもいい","… cũng được",1,"あまりに庶民すぎる夢……さすがに最近はかなり稼いでるだろうに……うなぎを食べまくるとかでもいいのでは……と思いました。",[43,47]],["N4","〜のに (dù)","dù … vậy mà",1,"建物は新しくなってるのに、右の凡庸な白身フライと豚肉のシャバシャバのやつも味が当時のまま。",[10,13]],["N4","〜ば (điều kiện)","nếu …",1,"青学といえば、最近は箱根駅伝で有名ですが、昔から野球部が強いんです。",[4,7]],["N4","〜たら","nếu / khi … thì",1,"コレちゃんが留年しそうな人にコールを呼び掛けたら、めちゃくちゃ多かった。",[22,25]],["N4","〜でしょう / 〜だろう","chắc là …",1,"あまりに庶民すぎる夢……さすがに最近はかなり稼いでるだろうに……うなぎを食べまくるとかでもいいのでは……と思いました。",[26,29]],["N3","〜終わる","… xong",4,"2ライブ終わりに",[4,7]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",3,"特に不味いってわけじゃないんだけど、積極的に食べるもんでもないやつです。",[7,11]],["N3","〜にする (chọn)","chọn / quyết định là …",3,"1あたしを彼女にしたいなら",[7,10]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",1,"最後はスーパー個人的な思い出による感想です。",[14,17]],["N3","〜として","với tư cách là …",1,"それはそれとして、コレちゃんが青学に舞い降りた！",[5,8]],["N3","〜ても / 〜でも (dù)","dù … cũng",1,"でも、そんな初心を忘れないコレちゃんが可愛くて大好き。",[0,3]],["N3","〜っぽい","có vẻ / hơi …",1,"今日は観客の8割ぐらいが青学生らしいんですが、ほとんどが大学生でちょっとだけ高等部生も交じってる感じだったっぽい。",[53,56]],["N3","〜わけではない","không hẳn là …",1,"特に不味いってわけじゃないんだけど、積極的に食べるもんでもないやつです。",[7,13]],["N3","〜ほど","đến mức … / khoảng …",1,"中等部の3年間、うんざりするほど讃美歌を歌わされた場所に、うん十年ぶりに入るという異常事態。",[14,16]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",1,"今日は観客の8割ぐらいが青学生らしいんですが、ほとんどが大学生でちょっとだけ高等部生も交じってる感じだったっぽい。",[8,11]],["N2","〜つつ","vừa … / tuy …",1,"コレサワって感じで、新しい『PINK BEARS』からの曲が主体になりつつも多種多様なセトリなんです。",[35,37]]]}
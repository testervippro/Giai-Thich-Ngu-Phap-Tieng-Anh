ument, reason, logic","LÝ KHUẤT",1,0,""],["一度","","nhất (Số 1) + độ (lần)","NHẤT ĐỘ",1,0,"ghep"],["眺める","ながめる","to gaze at [upon], to watch","THIẾU",1,0,""],["理由","りゆう","reason","LÝ DO",1,0,""],["釈然","","thích (Giải thích) + nhiên (Tự nhiên)","THÍCH NHIÊN",1,1,"ghep"]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",22,"あの道具には、タカト様の使用済みティッシュが使われているのである。",[25,28]],["N5","〜が (nhưng)","nhưng",7,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[0,3]],["N5","〜たい","muốn làm …",4,"暖房費が気になるこの季節、温かいうどんは実にありがたい。",[24,28]],["N5","〜前に","trước khi …",4,"しかし、目の前に転がる人魔の躯は、どうにもおかしい。",[5,8]],["N5","〜から (lý do)","vì … nên",3,"使用済みティッシュさえ手に入れば、それでよいのだから。",[23,27]],["N5","〜ませんか","… không? (rủ rê)",1,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[24,28]],["N5","〜たことがある","đã từng …",1,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[21,27]],["N5","〜てから","sau khi … rồi mới",1,"ただし、それは魔の生気を取り除く『魔抜き』を施してからの話である。",[24,27]],["N4","〜てくる","… dần lên / … rồi đến",15,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[21,24]],["N4","〜という","gọi là … / rằng …",15,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[9,12]],["N4","〜ば (điều kiện)","nếu …",14,"であれば、ここぞとばかりにソフィアが一肌脱ぐかもしれない。",[2,5]],["N4","〜でしょう / 〜だろう","chắc là …",13,"……この温かさ、できれば夕方まで持続してくれないだろうか（笑）。",[24,27]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",13,"そんなことをされたら、タカト様のタマタマはどうなってしまうのか。",[6,9]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",7,"そんなことをされたら、タカト様のタマタマはどうなってしまうのか。",[25,29]],["N4","〜てくれる","(ai đó) làm … cho mình",5,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[21,24]],["N4","〜ので","vì … (lý do khách quan)",5,"あの道具には、タカト様の使用済みティッシュが使われているのである。",[28,30]],["N4","〜かもしれない","có lẽ …",5,"であれば、ここぞとばかりにソフィアが一肌脱ぐかもしれない。",[22,26]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",5,"コウスケが、ちょうど移送命令書を書き終えたところであった。",[21,25]],["N4","〜と (điều kiện)","hễ … thì",3,"タカト様がどれほど疲れ果てようと、あの女には関係ない。",[14,17]],["N4","〜なら","nếu là … thì",3,"単に食うだけなら、そのような手間をかける必要もない。",[6,9]],["N4","〜はずだ","chắc chắn là … (theo lý)",3,"――ソフィアはタカト様を簡単に解放するはずがない……。",[19,21]],["N4","〜ようだ / 〜みたい","hình như / giống như …",3,"単に食うだけなら、そのような手間をかける必要もない。",[11,14]],["N4","〜ながら","vừa … vừa …",3,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[15,18]],["N4","〜ように (mục đích)","để …",2,"そう言うと、カルロスは傷ついた胸を伸ばすように、ゆっくりと背を反らした。",[20,24]],["N4","〜ために","để … / vì …",2,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[2,5]],["N4","〜たら","nếu / khi … thì",2,"そんなことをされたら、タカト様のタマタマはどうなってしまうのか。",[8,11]],["N4","使役 〜させる","bắt / cho phép làm …",2,"タカト様を好いているうえに、魔人ゆえの繁殖本能まで持ち合わせている。",[28,31]],["N4","〜ばかり","toàn là … / vừa mới …",2,"いずれも、製造方法を知らなければ答えの出ない疑問ばかりである。",[24,27]],["N4","〜てもいい","… cũng được",1,"いや、数字など、もはやどうでもよい。",[13,17]],["N4","〜ことができる","có thể …",1,"情報国や医療の国にいる人魔まで、ここへ呼び寄せることができるかもしれない。",[24,29]],["N4","〜てみる","thử làm …",1,"だが、そこで真音子は、ソフィアの立場になって考えてみた。",[24,27]],["N4","〜ていく","… dần đi / … rồi đi",1,"真音子の顔から、みるみる血の気が引いていった。",[18,21]],["N4","〜ようになる","trở nên (có thể) …",1,"朝晩はすっかり冷え込むようになってきた。",[11,16]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"シナシナになった切り干し大根を湯戻しするかのように、かろうじて戻った下半身をソフィアが嬉しそうにもてあそび始める。",[44,48]],["N4","〜らしい","có vẻ / đúng chất …",1,"そこへ、どん兵衛らしいもちっとしたうどん。",[8,11]],["N4","〜にくい","khó …",1,"いや、それは考えにくい。",[8,11]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",1,"ただし、それは魔の生気を取り除く『魔抜き』を施してからの話である。",[1,4]],["N4","〜しか〜ない","chỉ … (mà thôi)",1,"身にまとうものといえば、あの怪獣の着ぐるみぐらいしかない。",[24,28]],["N3","〜ほど","đến mức … / khoảng …",8,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[12,14]],["N3","〜として","với tư cách là …",7,"たとえ、その人魔がどこへ消えたのか、誰も知らなかったとしても。",[26,29]],["N3","〜続ける","tiếp tục …",4,"生むのは一人だけでなく、何人でも生み続けたい。",[18,21]],["N3","〜ことになる","được quyết định là / hoá ra là …",3,"――そ、そんなことになったら……私とタカト様の赤ちゃんは……？",[7,11]],["N3","〜ても / 〜でも (dù)","dù … cũng",3,"作っても作っても、片っ端から搾り取られてしまう。",[6,9]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",2,"かといって、道具による生産では、濃度に問題が出るだろう。",[8,11]],["N3","〜にとって","đối với (ai) …",2,"あの女にとって、タカト様は愛する相手ではない。",[3,7]],["N3","〜わけ","có nghĩa là / lý do / không hẳn là …",2,"そこで、タカトの服というわけだ。",[12,15]],["N3","〜ようとする","định / cố …",2,"何かを必死に押しのけようとしたのか、爪の一部が剥がれたものまであった。",[10,14]],["N3","〜はじめる / 〜始める","bắt đầu …",2,"真音子の頭の中で、長年温めてきた野望が、音を立てて崩れ始めた。",[27,30]],["N3","〜ば〜ほど","càng … càng …",2,"人魔を片付ければ片付けるほど、ソフィアの手柄になる。",[7,14]],["N3","〜くらい / 〜ぐらい","khoảng / đến mức …",2,"身にまとうものといえば、あの怪獣の着ぐるみぐらいしかない。",[21,24]],["N3","〜ないと","phải … (không thì)",2,"「ああ……コウスケ君が、この移送命令書を検査官に見せないといけない……」",[26,30]],["N3","〜ばかりでなく / 〜だけでなく","không chỉ … mà còn",1,"生むのは一人だけでなく、何人でも生み続けたい。",[6,11]],["N3","〜終わる","… xong",1,"それとも、一度使い切れば終わりなのか。",[12,15]],["N3","〜わけではない","không hẳn là …",1,"味さえ我慢できて、人を食うという罪悪感さえなければ、食料にならないわけではないのかもしれない。",[33,39]],["N3","〜てほしい","muốn (ai) làm …",1,"牛肉の旨みと甘めのつゆは体に染みるけれど、暖房代の請求書だけは心に染みてほしくないものですｗｗｗということで、きょうは「炭」つながりの話を。",[35,38]],["N3","〜たびに","mỗi lần …",1,"かといって、道具による生産では、濃度に問題が出るだろう。",[17,19]],["N3","〜せいで","tại / do (lỗi)",1,"そもそも、コウスケ自身が、その怪獣の着ぐるみのせいで、この貯蔵室に放り込まれているのである。",[23,26]],["N3","〜ために (nguyên nhân)","vì …",1,"――もしかして、タカト様を呼んだのも、食うためか……。",[21,24]],["N3","〜ことで","bằng việc … / do …",1,"牛肉の旨みと甘めのつゆは体に染みるけれど、暖房代の請求書だけは心に染みてほしくないものですｗｗｗということで、きょうは「炭」つながりの話を。",[51,54]],["N3","〜ずに","không … mà",1,"これでは、魔抜きもせずに食ったことになるではないか。",[10,12]],["N3","〜に違いない","chắc chắn là …",1,"そんな状態になっても、ソフィアはタカト様の命よりも、人魔を呼び寄せるための使用済みティッシュを優先するに違いない。",[51,55]],["N3","〜べき","nên / phải …",1,"暖房をつけるべきか、厚着で耐えるべきか……。",[6,8]],["N3","〜にする (chọn)","chọn / quyết định là …",1,"もっとも、そんな話があるということは、実際に口にした者がいるということなのだろう。",[23,26]],["N2","〜からこそ","chính vì …",3,"だからこそ、ソフィアはタカト様から製造方法を聞き出そうとしているのだろう。",[1,5]],["N2","〜かねない","có thể (điều xấu) …",3,"恋だの愛だのという過程をすっ飛ばして、いきなり繁殖行動に移りかねない。",[30,34]],["N2","〜ものだ","vốn dĩ là … / hay … (hồi xưa)",2,"そもそも、人であった者が魔の属性に堕ちてしまうのは、その魔の生気によるものだ。",[35,38]],["N2","〜としたら / 〜とすれば","giả sử …",1,"もっと強力なタマホイホイを作ろうとすれば、さらに多くの使用済みティッシュを必要とするかもしれない。",[16,20]],["N2","〜ことから","từ việc … (căn cứ)",1,"雪中送炭（せっちゅうそうたん）：雪の中で寒さに困っている人に炭を届けることから、困っているときに必要な助けを与えること。",[35,39]],["N2","〜うえに","hơn nữa …",1,"タカト様を好いているうえに、魔人ゆえの繁殖本能まで持ち合わせている。",[10,13]],["N2","〜というものだ","đó mới gọi là …",1,"ならば、そのコウスケが移送命令書を検査官に提示するのが、最も自然というものだ。",[32,38]],["N1","〜であれ","dù là …",1,"であれば、ここぞとばかりにソフィアが一肌脱ぐかもしれない。",[0,3]]],"glue":[[1,87,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[13,14],0],[2,63,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[9,10],0],[3,92,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[16,17],0],[4,67,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[10,11],0],[5,21,"真音子の頭の中で、長年温めてきた野望が、音を立てて崩れ始めた。",[7,8],0],[6,92,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[8,9],0],[7,25,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[23,24],0],[8,24,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[11,12],0],[9,17,"次から次へと集まってくる人魔を処理し、食い、また次の人魔を待つ。",[1,3],0],[10,11,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[8,10],0],[11,7,"たとえ、その人魔がどこへ消えたのか、誰も知らなかったとしても。",[11,12],0],[12,3,"もし、機械で搾り取るよりも、自分の体を使ったほうが良質な使用済みティッシュを得られると分かったなら？",[10,12],0],[13,35,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[3,4],0],[14,4,"だが、肌や血痕には、まだ魔の生気が残留している。",[4,5],0],[15,62,"であれば、ここぞとばかりにソフィアが一肌脱ぐかもしれない。",[18,22],0],[16,4,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[24,27],0],[17,62,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[28,29],0],[18,35,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[25,29],0],[19,18,"真音子の頭の中で、長年温めてきた野望が、音を立てて崩れ始めた。",[24,25],0],[20,22,"あの道具には、タカト様の使用済みティッシュが使われているのである。",[25,28],0],[21,4,"ソフィアが知りたがっている、その燃料の正体を。",[7,8],0],[22,14,"そんなことをされたら、タカト様のタマタマはどうなってしまうのか。",[7,8],0],[24,29,"――そ、そんなことになったら……私とタカト様の赤ちゃんは……？",[12,14],0],[25,2,"作っても作っても、片っ端から搾り取られてしまう。",[2,4],0],[26,4,"いずれも、製造方法を知らなければ答えの出ない疑問ばかりである。",[12,16],0],[27,3,"使用済みティッシュさえ手に入れば、それでよいのだから。",[19,22],0],[28,1,"情報国や医療の国にいる人魔まで、ここへ呼び寄せることができるかもしれない。",[24,29],0],[29,8,"それに、わざわざタマホイホイの製造方法を聞き出そうとしているのだ。",[24,25],0],[30,3,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[15,18],0],[31,4,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[2,5],0],[32,2,"そうなれば、ソフィアは人魔を探すどころか、ただ待っているだけでよい。",[0,3],0],[33,3,"単に食うだけなら、そのような手間をかける必要もない。",[11,14],0],[34,1,"そこへ、どん兵衛らしいもちっとしたうどん。",[8,11],0],[35,13,"……この温かさ、できれば夕方まで持続してくれないだろうか（笑）。",[24,27],0],[36,5,"であれば、ここぞとばかりにソフィアが一肌脱ぐかもしれない。",[22,26],0],[37,20,"甘めのつゆとの相性もよく、寒い日には実にありがたい味わいだ。",[13,15],0],[38,61,"甘めのつゆとの相性もよく、寒い日には実にありがたい味わいだ。",[28,29],0],[39,3,"なんともふざけた名前ではあるが、問題はそこではない。",[14,15],0],[40,5,"使用済みティッシュさえ手に入れば、それでよいのだから。",[24,26],0],[41,1,"ミーアでさえ危険度一千万だったというのに。",[18,20],0],[42,42,"日清の「どん兵衛　肉うどん」甘めつゆに染みわたるコク旨牛肉。",[21,24],0],[43,49,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[22,24],0],[44,17,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[9,12],0],[45,17,"だが、人魔を食ったという話は、真音子も聞いたことがなかった。",[9,12],0],[46,4,"しかし、目の前に転がる人魔の躯は、どうにもおかしい。",[0,3],0],[47,4,"そして、その曲を最後に、ドビュッシーは亡くなったのだ。",[0,3],0],[48,1,"次から次へと集まってくる人魔を処理し、食い、また次の人魔を待つ。",[22,24],0],[49,6,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[0,4],0],[50,1,"雪中送炭（せっちゅうそうたん）：雪の中で寒さに困っている人に炭を届けることから、困っているときに必要な助けを与えること。",[45,47],0],[54,2,"かといって、道具による生産では、濃度に問題が出るだろう。",[8,11],0],[55,7,"たとえ、その人魔がどこへ消えたのか、誰も知らなかったとしても。",[26,29],0],[58,2,"あの女にとって、タカト様は愛する相手ではない。",[3,6],0],[61,1,"すでに命気は尽きている。",[0,3],0],[62,1,"だが、肌や血痕には、まだ魔の生気が残留している。",[10,12],0],[63,4,"好きだからこそ、タカト様の子をもうけたい。",[15,17],0],[67,2,"さらに、大量生産は可能なのか。",[0,3],0],[77,21,"人魔を捜索し、捕らえ、処理することこそが、あの女の仕事なのだ。",[28,30],0],[79,1,"カルロスさん、死んでなかった！",[9,10],0],[80,1,"――待てよ……人魔……。",[4,5],0],[81,2,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[28,29],0],[82,1,"……いや、それだと確実に寝るなｗｗｗ",[14,15],0],[85,1,"いただきます！",[0,3],0],[90,7,"そんな暖房費とにらめっこしながら湯を沸かし、手に取ったのは",[18,22],0],[91,2,"それどころか、とうとう種なしになってしまうかもしれないではないか！",[25,28],0],[92,7,"そんなことをされたら、タカト様のタマタマはどうなってしまうのか。",[25,29],0],[94,8,"そのとき、カルロスが胸を押さえながら、ふらふらと戻ってきた。",[26,28],0],[95,2,"だが、そこで真音子は、ソフィアの立場になって考えてみた。",[24,26],0],[97,5,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[21,24],0],[98,1,"朝晩はすっかり冷え込むようになってきた。",[11,16],0],[99,3,"――そ、そんなことになったら……私とタカト様の赤ちゃんは……？",[7,12],0],[100,3,"――ソフィアはタカト様を簡単に解放するはずがない……。",[19,21],0],[101,2,"そこで、タカトの服というわけだ。",[12,14],0],[102,1,"暖房をつけるべきか、厚着で耐えるべきか……。",[6,8],0],[103,14,"いずれも、製造方法を知らなければ答えの出ない疑問ばかりである。",[24,27],0],[104,8,"そのために、これまでどれほどの想いを胸に秘めてきたことか。",[12,14],0],[105,5,"使用済みティッシュさえ手に入れば、それでよいのだから。",[9,11],0],[106,2,"――まさか……生きたまま食っているのか……。",[10,12],0],[109,2,"いや、人魔の肉は、たとえ魔抜きをしたところで臭くて食えたものではないという話もある。",[22,25],0],[110,16,"甘めのつゆとの相性もよく、寒い日には実にありがたい味わいだ。",[10,12],0],[111,7,"かといって、寒さを我慢して風邪でも引いたら、それこそ余計な出費だ。",[26,29],0],[112,80,"……誰か、暖房費の方にも救いの手を差し伸べてくれませんかね？",[2,3],0],[114,3,"――ソフィアの危険度は……完全に一億越えですわ！",[16,18],0],[115,2,"その気持ちだけは、真音子にも理解できた。",[14,19],0]],"gseen":45,"read":[{"s":"香炉のような形状からして、中で何かを燃やしていることぐらいは分かるだろう。","c":[[["香炉","n","HƯƠNG LÔ","hương thơm + cái lò"],["の","p","",""],["よう","n","",""],["な","v","",""],["形状","n","HÌNH TRẠNG","hình dạng + trạng thái"],["から","p","",""]],[["し","v","",""],["て","p","",""],["、","o","",""]],[["中","n","TRUNG","the inside, in the middle"],["で","p","",""]],[["何","n","HÀ","what"],["か","p","",""],["を","p","",""]],[["燃やし","v","NHIÊN","to burn (vt.)"],["て","p","",""],["いる","v","",""],["こと","n","",""],["ぐらい","p","",""],["は","p","",""]],[["分かる","v","PHÂN","to understand, to realise"],["だろ","v","",""],["う","v","",""]]],"g":[[1,29,30],[3,17,18],[5,14,15],[6,2,3],[9,8,10],[13,16,17],[15,30,33],[19,11,12],[20,21,24],[33,3,6],[35,33,36],[43,24,26],[104,26,29],[112,15,16]],"v":[[0,13,19,[["の","香炉のよう","よう của 香炉"]],"Nhìn hình dạng giống như lư hương thì","Judging from its incense-burner-like shape,"],[13,37,null,[["koto","[中で何かを燃やしている]こと","việc / điều (mà) 中で何かを燃やしている"]],"cũng đoán được là bên trong đang đốt thứ gì đó.","you can at least tell something is being burned inside."]],"vi":"Nhìn hình dạng giống như lư hương thì cũng đoán được là bên trong đang đốt thứ gì đó.","en":"Judging from its incense-burner-like shape, you can at least tell something is being burned inside."},{"s":"情報国や医療の国にいる人魔まで、ここへ呼び寄せることができるかもしれない。","c":[[["情報","n","TÌNH BÁO","information"],["国","n","QUỐC","country, nation"],["や","p","",""]],[["医療","n","Y LIỆU","y tế + trị liệu"],["の","p","",""],["国","n","QUỐC","country, nation"],["に","p","",""]],[["いる","v","",""],["人","n","NHÂN","person"],["魔","n","MA","ma quỷ"],["まで","p","",""],["、","o","",""]],[["ここ","n","",""],["へ","p","",""]],[["呼び寄せる","v","HÔ KÍ","hô hấp + kí gửi"],["こと","n","",""],["が","p","",""]],[["できる","v","",""],["かも","p","",""]],[["しれ","v","",""],["ない","v","",""]]],"g":[[4,8,9],[6,6,7],[10,13,15],[11,18,19],[14,3,4],[15,19,24],[15,27,30],[18,34,36],[28,24,29],[36,30,34],[42,9,11],[43,24,26],[112,16,18]],"v":[[0,16,"、",[["の","医療の国","国 của 医療"],["57","[情報国や医療の国にいる]人魔","人魔 mà 情報国や医療の国にいる"]],"Có lẽ có thể triệu tập về đây","Even the human-demons in the information nation and the medical nation"],[16,37,null,[["koto","[ここへ呼び寄せる]こと","việc / điều (mà) ここへ呼び寄せる"]],"cả những nhân ma đang ở nước thông tin và nước y tế.","might be possible to summon here."]],"vi":"Có lẽ có thể triệu tập về đây cả những nhân ma đang ở nước thông tin và nước y tế.","en":"It might even be possible to summon here the human-demons living in the information nation and the medical nation."},{"s":"だが、人魔を食ったという話は、真音子も聞いたことがなかった。","c":[[["だが","o","",""],["、","o","",""]],[["人","n","NHÂN","person"],["魔","n","MA","ma quỷ"],["を","p","",""]],[["食っ","v","THỰC","to eat"],["た","v","",""],["という","p","",""]],[["話","n","THOẠI","hội thoại"],["は","p","",""],["、","o","",""]],[["真","n","CHÂN","chân thật"],["音","n","ÂM","sound"],["子","n","TỬ","con"],["も","p","",""]],[["聞い","v","VĂN","to hear, to listen"],["た","v","",""],["こと","n","",""],["が","p","",""]],[["なかっ","v","",""],["た","v","",""]]],"g":[[1,13,14],[2,24,25],[3,5,6],[8,18,19],[17,8,9],[17,21,22],[18,25,29],[43,22,24],[44,9,12],[45,9,12]],"v":[[0,3,"、",[],"Nhưng","But"],[3,15,"、",[["を","人魔を…食っ","食う → 人魔"]],"chuyện ăn thịt nhân ma","the story of eating a human-demon"],[15,30,null,[["koto","[聞いた]こと","việc / điều (mà) 聞いた"]],"Maneko chưa từng nghe.","Maneko had never heard either."]],"vi":"Nhưng Maneko chưa từng nghe chuyện ăn thịt nhân ma.","en":"But Maneko had never heard of anyone eating a human-demon."},{"s":"タカト様を求めるのは、タカト様が好きだから。","c":[[["タカト","n","","(từ ngoại lai)"],["様","n","DẠNG","hình dạng"],["を","p","",""]],[["求める","v","CẦU","to demand, to request"],["の","n","",""],["は","p","",""],["、","o","",""]],[["タカト","n","","(từ ngoại lai)"],["様","n","DẠNG","hình dạng"],["が","p","",""]],[["好き","n","HẢO","thích"],["だ","v","",""],["から","p","",""]]],"g":[[1,9,10],[2,15,16],[3,4,5],[15,5,8],[38,18,19],[40,19,21],[43,8,9],[49,18,21]],"v":[[0,11,"、",[["koto","[タカト様を求める]の","việc / điều (mà) タカト様を求める"],["を","タカト様を…求める","求める → タカト様"]],"Tìm kiếm Takato-sama là","
rên)","? THƯỢNG",1,1,"ghep"],["骨","ほね","bone","CỐT",1,0,""],["疲れる","つかれる","to be tired, to grow weary","BÌ",1,0,""],["釜","かま","rice-cooker, tea kettle","PHỦ",1,1,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",5,"明日までかかるかなと思っていましたが、今日終わりましたね。",[12,16]],["N5","〜が (nhưng)","nhưng",5,"一番不人気だったらしいですが、個人的に欲しい素材がここに。",[11,15]],["N5","〜たい","muốn làm …",2,"最低でも5つは残しておきたいので、2つは使ってしまおう！",[11,15]],["N4","〜ので","vì … (lý do khách quan)",7,"一番不人気だった青水キメラが最後に撃破されたので、これで終わり？",[22,24]],["N4","〜という","gọi là … / rằng …",7,"が、300万体ということであっっっという間に消滅しました。",[7,10]],["N4","〜らしい","có vẻ / đúng chất …",4,"一番不人気だったらしいですが、個人的に欲しい素材がここに。",[8,11]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",3,"一番不人気だった青水キメラが最後に撃破されたので、これで終わり？",[19,22]],["N4","〜ていく","… dần đi / … rồi đi",2,"精霊根の人気がすごくて他のエリアの倍以上のスピードで撃破されていきました。",[30,33]],["N4","〜てくる","… dần lên / … rồi đến",2,"結果的に98個から、最終500個以上集めることができて最高でした。",[24,27]],["N4","〜でしょう / 〜だろう","chắc là …",2,"実際どういう予定だったんだろうかは気になります。",[12,15]],["N4","〜ことができる","có thể …",1,"結果的に98個から、最終500個以上集めることができて最高でした。",[21,26]],["N4","〜予定","dự định …",1,"実際どういう予定だったんだろうかは気になります。",[6,9]],["N4","〜ておく","làm sẵn, làm trước",1,"最低でも5つは残しておきたいので、2つは使ってしまおう！",[9,12]],["N4","〜たら","nếu / khi … thì",1,"アペンドスキルを上げれるだけ上げていったら、消費がめちゃくちゃ激しいのが銅素材です。",[19,22]],["N4","〜ながら","vừa … vừa …",1,"と思いながら、残していた各地のぷに滅戦を進めると。",[3,6]],["N4","〜し、〜し","vừa … lại vừa … (liệt kê lý do)",1,"というサプライズはありましたが、絆上げもできたし、杭・レンズ・骨あたりを集めれたのはよかったです。",[22,25]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"まぁ杭を集めたかったので、知っていたところで攻略順は変わらなかったのでよしです。",[18,22]],["N3","〜ことで","bằng việc … / do …",4,"が、300万体ということであっっっという間に消滅しました。",[10,13]],["N3","〜終わる","… xong",2,"明日までかかるかなと思っていましたが、今日終わりましたね。",[21,24]],["N3","〜ほど","đến mức … / khoảng …",2,"杭が90個ほどしかなくて。",[5,7]],["N2","〜に加えて","thêm vào …",1,"初期1,000万体に加えて500万＋1,000万＋600万の3おかわり合計3,100万体という異常な数。",[9,12]],["N2","〜に限る","chỉ … / … là nhất",1,"数に限りのある大変貴重な夢火。",[1,4]]]}
","しく","to pave, to cover, to spread [lay out] (a futon, mat, etc.)","PHU",1,1,""],["集落","","tập (Tập trung) + lạc (Rơi xuống)","TẬP LẠC",1,0,"ghep"],["参加","さんか","する：to participate, to join","THAM GIA",1,0,""],["中","なか","the inside, in the middle","TRUNG",1,0,""],["同好会","","đồng (giống nhau) + hảo (Thích) + hội (Gặp gỡ)","ĐỒNG HẢO HỘI",1,0,"ghep"],["村","むら","village","THÔN",1,0,""]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",5,"ここまで線路が敷かれるだけのことはありそうな集落となっている。",[27,30]],["N5","〜が (nhưng)","nhưng",4,"弥冨から玉ノ井までの30km強だが、直通する電車はない。",[15,18]],["N5","〜前に","trước khi …",1,"静まり返った高架のホームの目の前に、古い団地が早春のような日射しを浴びている。",[14,17]],["N5","〜てから","sau khi … rồi mới",1,"近鉄弥冨で降りて、ＪＲと名鉄一体の弥冨駅までは歩いてすぐだが、時間があったので、コンビニで一服してから周辺を散歩。",[48,51]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",2,"ここまで線路が敷かれるだけのことはありそうな集落となっている。",[8,11]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",1,"稲が刈られずほったらかしの田んぼが目に付いたが、米の値段が下がってしまったからか。",[32,36]],["N4","〜てくる","… dần lên / … rồi đến",1,"快晴の予報だったのに、朝、家を出るとどん曇りで面食らったが、近鉄特急で三重に入ったら晴れてきた。",[44,47]],["N4","〜ので","vì … (lý do khách quan)",1,"近鉄弥冨で降りて、ＪＲと名鉄一体の弥冨駅までは歩いてすぐだが、時間があったので、コンビニで一服してから周辺を散歩。",[37,39]],["N4","〜のに (dù)","dù … vậy mà",1,"快晴の予報だったのに、朝、家を出るとどん曇りで面食らったが、近鉄特急で三重に入ったら晴れてきた。",[8,11]],["N4","〜かもしれない","có lẽ …",1,"駅の西側には高いところに県道が走っていて、これは木曽川のかつての堤防なのかもしれない。",[36,40]],["N4","〜そうだ (trông có vẻ)","trông có vẻ …",1,"ここまで線路が敷かれるだけのことはありそうな集落となっている。",[18,22]],["N4","〜ようだ / 〜みたい","hình như / giống như …",1,"静まり返った高架のホームの目の前に、古い団地が早春のような日射しを浴びている。",[26,29]],["N4","〜らしい","có vẻ / đúng chất …",1,"戦前はこの先にも線路が延びていたらしいが、痕跡は見当たらない。",[16,19]],["N4","〜ところ","đúng lúc … (sắp/đang/vừa)",1,"駅の西側には高いところに県道が走っていて、これは木曽川のかつての堤防なのかもしれない。",[8,12]],["N3","〜ほど","đến mức … / khoảng …",2,"折り返し便を１本パスして、40分ほど周辺を散策。",[16,18]]]}
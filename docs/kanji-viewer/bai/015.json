,"ghep"],["向かう","むかう","to face (towards), to head for, to trend towards","HƯỚNG",1,0,""],["冒頭","ぼうとう","the beginning, the opening","MẠO ĐẦU",1,0,""],["不気味な","ぶきみな","weird, eerie","BẤT KHÍ VỊ",1,1,""],["余韻","","dư (dư thừa) + vận (Vần điệu)","DƯ VẬN",1,1,"ghep"],["幕","まく","(stage) curtain, act (of a play)","MẠC",1,0,""],["閉じる","とじる","to close","BẾ",1,0,""],["脚本","きゃくほん","scenario, playbook","CƯỚC BẢN",1,0,""],["話構成","","thoại (Hội thoại) + cấu (cấu tạo) + thành (thành công)","THOẠI CẤU THÀNH",1,1,"ghep"],["話目","","thoại (Hội thoại) + mục (Mắt)","THOẠI MỤC",1,1,"ghep"],["時","とき","time","THỜI",1,0,""],["調べる","しらべる","to study, to investigate, to examine","ĐIỀU",1,1,""],["多大","","đa (Nhiều) + đại (To lớn)","ĐA ĐẠI",1,1,"ghep"],["例えば","たとえば","for example","LỆ",1,0,""],["発端","","phát (phát triển) + đoan (cực đoan)","PHÁT ĐOAN",1,1,"ghep"],["動画","","động (Chuyển động) + họa, hoạch (Họa sĩ)","ĐỘNG HỌA, HOẠCH",1,0,"ghep"],["強い","つよい","strong, powerful","CƯỜNG",1,0,""],["言う","いう","to say, to talk about, to tell","NGÔN",1,0,""],["今挙","","kim (Bây giờ) + cử (tuyển cử)","KIM CỬ",1,1,"ghep"],["計る","はかる","to measure","KẾ",1,0,""],["生まれる","うまれる","to be born","SINH",1,0,""],["物語る","ものがたる","to narrate, to show (the fact that ～)","VẬT NGỮ",1,0,""],["宝庫的","","bảo (Bảo vật) + khố (Kho) + đích (Mục đích)","BẢO KHỐ ĐÍCH",1,1,"ghep"]],"grammar":[["N5","〜ています / 〜ている","đang làm / trạng thái (đã … và vẫn còn)",20,"怪物との遭遇を終えたヴァレンタインは、救急車で病院へと搬送されていた。",[31,34]],["N5","〜が (nhưng)","nhưng",2,"まるで『世にも奇妙な物語』のような映画だと1話目を観た時から感じましたが、調べてみると、『ウルトラQ』『奇妙な出来事』『世にも奇妙な物語』など後",[34,37]],["N4","受身 〜られる / 〜れる","bị / được … (bị động, khả năng, tôn kính)",10,"周囲の乗客や乗務員に落ち着くよう促されるが、彼の恐怖は収まらない。",[17,20]],["N4","〜という","gọi là … / rằng …",6,"そんな施設に、新たにブルームという老人が入居してくる。",[14,17]],["N4","〜てしまう / 〜ちゃう","lỡ …, … mất rồi / làm xong hẳn",3,"やがて店を出た彼は、見知らぬ異国の町に迷い込んでしまう。",[23,27]],["N4","〜ていく","… dần đi / … rồi đi",3,"最初は戸惑っていた老人たちも、やがて彼の言葉に心を動かされ、夜の庭へと飛び出していく。",[39,42]],["N4","〜ようだ / 〜みたい","hình như / giống như …",3,"かつての活気や若さを失い、残された人生に希望を見いだせず、ただ死を待つような毎日を送っている。",[35,38]],["N4","使役 〜させる","bắt / cho phép làm …",3,"気に入らない相手を消し去り、思い描いた怪物や出来事を実体化させることもできるのだ。",[29,32]],["N4","〜てくる","… dần lên / … rồi đến",2,"そんな施設に、新たにブルームという老人が入居してくる。",[23,26]],["N4","〜ので","vì … (lý do khách quan)",2,"例えばYouTubeで『トワイライト・ゾーンが発端となったもの ランキングTop10』という動画で知ったのですが↓",[52,54]],["N4","〜と (điều kiện)","hễ … thì",2,"運転手はサイレンを止めると、車内に音楽を流し始める。",[11,14]],["N4","〜ながら","vừa … vừa …",2,"音楽を聴きながら、運転手は助手席の同乗者に向かって「本当に怖いものを見たくないか？",[5,8]],["N4","〜てみる","thử làm …",1,"世にも奇妙な物語』のような映画だと1話目を観た時から感じましたが、調べてみると、『ウルトラQ』『奇妙な出来事』『世にも奇妙な物語』など後の多くの作",[35,38]],["N4","〜そうだ (nghe nói)","nghe nói …",1,"なども、『トワイライト・ゾーン』の影響を強く受けていると言われているそうです。",[33,38]],["N4","〜場合","trường hợp …",1,"スト』や『グレムリン』などで自分は製作に回り、演出は他の監督が担当する場合にはゴールドスミスを起用する傾向がある。",[35,37]],["N3","〜はじめる / 〜始める","bắt đầu …",4,"音楽を聴けなくなった二人は、退屈しのぎに会話を始める。",[23,26]],["N3","〜ことになる","được quyết định là / hoá ra là …",3,"ヘレンは少年の無邪気な笑顔の裏に潜む、底知れない恐怖を知ることになる。",[29,33]],["N3","〜によって / 〜による","do / bởi / tuỳ theo …",2,"こうして本作は、スピルバーグ監督映画としては珍しいジョン・ウィリアムズ以外の作曲家による音楽が付いた作品となった。",[41,44]],["N3","〜として","với tư cách là …",2,"こうして本作は、スピルバーグ監督映画としては珍しいジョン・ウィリアムズ以外の作曲家による音楽が付いた作品となった。",[18,21]],["N3","〜ても / 〜でも (dù)","dù … cũng",2,"ヴァレンタインが周囲に助けを求めても、怪物はその姿を隠してしまい、誰も彼の話を信じようとしない。",[16,19]],["N3","〜ようとする","định / cố …",1,"ヴァレンタインが周囲に助けを求めても、怪物はその姿を隠してしまい、誰も彼の話を信じようとしない。",[41,45]],["N3","〜たびに","mỗi lần …",1,"裸の人間のような姿をしたその生物は、異常な高度にもかかわらず自由に飛び回り、やがてエンジンを破壊し始める。",[22,24]],["N3","〜ことで","bằng việc … / do …",1,"自分がこれまで蔑んできた人々の立場を次々と体験することで、彼は差別される側の恐怖と苦痛を思い知らされていく。",[25,28]],["N3","〜ほど","đến mức … / khoảng …",1,"アンソニーは家族から過剰なほど気を遣われ、誰も彼の機嫌を損ねないように振る舞っている。",[13,15]],["N3","〜べき","nên / phải …",1,"忘れていた子供時代の喜びを取り戻した彼らは、驚くべき変化を体験することになる。",[24,26]],["N3","〜ところが","thế nhưng",1,"ところが突然、カセットテープが故障し、カーラジオも使えなくなってしまう。",[0,4]],["N2","〜をはじめ","tiêu biểu là / trước hết là …",1,"音楽を聴けなくなった二人は、退屈しのぎに会話を始める。",[22,25]],["N2","〜にもかかわらず","mặc dù …",1,"裸の人間のような姿をしたその生物は、異常な高度にもかかわらず自由に飛び回り、やがてエンジンを破壊し始める。",[23,30]],["N2","〜気味","hơi có vẻ …",1,"その言葉とともに、物語は冒頭の二人の男の会話へとつながり、映画は不気味な余韻を残して幕を閉じる。",[33,35]],["N2","〜次第","ngay khi / tuỳ vào …",1,"彼は他の老人たちとは違い、年齢を重ねても心の持ち方次第で人生を楽しめると信じていた。",[25,27]],["N2","〜とともに","cùng với …",1,"その言葉とともに、物語は冒頭の二人の男の会話へとつながり、映画は不気味な余韻を残して幕を閉じる。",[4,8]]],"glue":[[1,41,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[13,14],0],[2,18,"実は彼には、想像したことを現実にする恐ろしい能力があった。",[24,25],0],[3,36,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[24,25],0],[4,30,"実は彼には、想像したことを現実にする恐ろしい能力があった。",[3,4],0],[5,14,"怪物との遭遇を終えたヴァレンタインは、救急車で病院へと搬送されていた。",[22,23],0],[6,54,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[18,19],0],[7,20,"運転手はサイレンを止めると、車内に音楽を流し始める。",[12,13],0],[8,10,"ところが突然、カセットテープが故障し、カーラジオも使えなくなってしまう。",[24,25],0],[9,5,"機体から身を乗り出して対峙した末、怪物は銃をかじって飛び去る。",[2,4],0],[10,2,"自分がこれまで蔑んできた人々の立場を次々と体験することで、彼は差別される側の恐怖と苦痛を思い知らされていく。",[5,7],0],[11,6,"怪物との遭遇を終えたヴァレンタインは、救急車で病院へと搬送されていた。",[25,26],0],[13,3,"しかし、そこに暮らす家族の様子はどこか異様だった。",[18,19],0],[14,6,"周囲の乗客や乗務員に落ち着くよう促されるが、彼の恐怖は収まらない。",[5,6],0],[15,24,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[27,29],0],[17,32,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[6,7],0],[18,1,"まるで『世にも奇妙な物語』のような映画だと1話目を観た時から感じましたが、調べてみると、『ウルトラQ』『奇妙な出来事』『世にも奇妙な物語』な",[32,35],0],[19,11,"周囲の乗客や乗務員に落ち着くよう促されるが、彼の恐怖は収まらない。",[30,32],0],[21,2,"『トワイライト・ゾーン』がなければ生まれなかった物語も多くあるアイデアの宝庫的な作品です。",[20,24],0],[22,14,"機体から身を乗り出して対峙した末、怪物は銃をかじって飛び去る。",[10,11],0],[23,19,"怪物との遭遇を終えたヴァレンタインは、救急車で病院へと搬送されていた。",[31,33],0],[24,2,"音楽を聴きながら、運転手は助手席の同乗者に向かって「本当に怖いものを見たくないか？",[35,37],0],[25,13,"周囲の乗客や乗務員に落ち着くよう促されるが、彼の恐怖は収まらない。",[18,20],0],[26,3,"気に入らない相手を消し去り、思い描いた怪物や出来事を実体化させることもできるのだ。",[30,32],0],[30,2,"彼は他の老人たちとは違い、年齢を重ねても心の持ち方次第で人生を楽しめると信じていた。",[18,20],0],[31,1,"『トワイライト・ゾーン』がなければ生まれなかった物語も多くあるアイデアの宝庫的な作品です。",[13,17],0],[34,3,"ある夜、ブルームは銀色の空き缶を取り出し、皆で缶蹴りをしようと提案する。",[29,30],0],[35,2,"音楽を聴きながら、運転手は助手席の同乗者に向かって「本当に怖いものを見たくないか？",[5,8],0],[37,1,"なども、『トワイライト・ゾーン』の影響を強く受けていると言われているそうです。",[34,38],0],[38,4,"アンソニーは家族から過剰なほど気を遣われ、誰も彼の機嫌を損ねないように振る舞っている。",[32,35],0],[42,5,"実は彼には、想像したことを現実にする恐ろしい能力があった。",[18,22],0],[45,17,"無事に着陸した後、地上係員はエンジンの異常な破壊を発見する。",[21,22],0],[47,1,"しかし、そこに暮らす家族の様子はどこか異様だった。",[0,3],0],[48,1,"そして、彼らが語り始めた奇妙な物語は、やがて現実と幻想の境界が曖昧になる、不可思議な世界へと観客を誘っていく。",[0,3],0],[51,4,"周囲の乗客や乗務員に落ち着くよう促されるが、彼の恐怖は収まらない。",[20,21],0],[52,1,"ゴールドスミスはもともとオリジナル・テレビシリーズに参加しており『ミステリー・ゾーン』を熟知していたので、当然の起用であった。",[50,52],0],[54,1,"まるで『世にも奇妙な物語』のような映画だと1話目を観た時から感じましたが、調べてみると、『ウルトラQ』『奇妙な出来事』『世にも",[27,28],0],[57,22,"しかし、そこに暮らす家族の様子はどこか異様だった。",[7,10],0],[58,9,"実は彼には、想像したことを現実にする恐ろしい能力があった。",[10,12],0],[59,6,"そんな施設に、新たにブルームという老人が入居してくる。",[14,17],0],[60,6,"そんな施設に、新たにブルームという老人が入居してくる。",[14,17],0],[62,2,"こうして本作は、スピルバーグ監督映画としては珍しいジョン・ウィリアムズ以外の作曲家による音楽が付いた作品となった。",[41,44],0],[63,2,"こうして本作は、スピルバーグ監督映画としては珍しいジョン・ウィリアムズ以外の作曲家による音楽が付いた作品となった。",[18,21],0],[67,1,"その言葉とともに、物語は冒頭の二人の男の会話へとつながり、映画は不気味な余韻を残して幕を閉じる。",[4,8],0],[75,1,"そこでは彼自身がユダヤ人としてナチスに追われ、次には黒人として白人警察に追跡され、さらにベトナム人として米軍から敵視されることになる。",[41,44],0],[76,1,"特に黒人やユダヤ人、アジア人など、異なる人種や民族に対する偏見と憎悪は激しく、バーでも友人や黒人客を前に差別的な暴言を吐き散らす。",[0,2],0],[80,1,"世にも奇妙な物語』など後の多くの作品に多大な影響を与えている作品であることがわかりました。",[35,40],0],[83,1,"らく、今挙げた作品以外にも、多くの作品が『トワイライト・ゾーン』の影響を受けていると思われ、『トワイライト・ゾーン』というアメリカのテレビドラマが",[35,38],0],[85,3,"気に入らない相手を消し去り、思い描いた怪物や出来事を実体化させることもできるのだ。",[38,40],0]],"gseen":60,"read":[{"s":"怪物との遭遇を終えたヴァレンタインは、救急車で病院へと搬送されていた。","c":[[["怪物","n","QUÁI VẬT","monster"],["と","p","",""],["の","p","",""],["遭遇","n","TAO NGỘ","する：to encounter, to come across"],["を","p","",""]],[["終え","v","CHUNG","to end, to finish"],["た","v","",""],["ヴァレンタイン","n","","(từ ngoại lai)"],["は","p","",""],["、","o","",""]],[["救急","n","CỨU CẤP","cứu giúp + khẩn cấp"],["車","n","XA","car"],["で","p","",""]],[["病院","n","BỆNH VIỆN","hospital"],["へ","p","",""],["と","p","",""]],[["搬送","n","BAN, BÀN TỐNG","vận chuyển + gửi đi"],["さ","v","",""],["れ","v","",""],["て","p","",""],["い","v","",""],["た","v","",""]]],"g":[[1,17,18],[3,6,7],[5,22,23],[6,3,4],[7,26,27],[11,25,26],[17,9,10],[17,33,34],[23,31,33],[25,30,31],[57,9,10],[59,2,4]],"v":[[0,19,"、",[["57","[怪物との遭遇を終えた]ヴァレンタイン","ヴァレンタイン mà 怪物との遭遇を終えた"],["を","の遭遇を…終え","終える → の遭遇"]],"Sau khi kết thúc cuộc chạm trán với qu